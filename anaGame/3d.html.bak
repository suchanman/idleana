<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>OVERWATCH - 아나(Ana) 3D 시뮬레이터</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@500;700;900&family=Orbitron:ital,wght@0,700;0,900;1,800&display=swap" rel="stylesheet">
    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            box-sizing: border-box;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #0b1320;
            font-family: 'Noto Sans KR', sans-serif;
        }
        #game-canvas {
            display: block;
            width: 100%;
            height: 100%;
            cursor: crosshair;
        }
        .ow-font {
            font-family: 'Orbitron', 'Noto Sans KR', sans-serif;
            font-style: italic;
        }
        /* Overwatch skewed HUD boxes */
        .ow-skew {
            transform: skewX(-12deg);
        }
        .ow-unskew {
            transform: skewX(12deg);
        }
        /* Health pip bar styling */
        .hp-pip {
            width: 14px;
            height: 22px;
            margin-right: 3px;
            border-radius: 2px;
            transform: skewX(-15deg);
            transition: background-color 0.15s ease, box-shadow 0.15s ease;
        }
        /* Ability icon box */
        .ability-box {
            width: 60px;
            height: 60px;
            background: rgba(15, 23, 42, 0.78);
            border: 2px solid rgba(255, 255, 255, 0.35);
            border-radius: 8px;
            transform: skewX(-10deg);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            backdrop-filter: blur(6px);
            transition: all 0.15s ease;
        }
        .ability-box.ready:hover {
            border-color: #38bdf8;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.5);
        }
        .ability-box.on-cooldown {
            background: rgba(15, 23, 42, 0.92);
            border-color: rgba(239, 68, 68, 0.6);
        }
        /* Sniper Scope Overlay */
        #scope-overlay {
            pointer-events: none;
            transition: opacity 0.12s ease;
        }
        .scope-vignette {
            background: radial-gradient(circle at center, transparent 34%, rgba(6, 12, 24, 0.65) 38%, rgba(4, 8, 16, 0.97) 44%);
        }
        /* World-space floating HP bars */
        .world-label {
            position: absolute;
            pointer-events: none;
            transform: translate(-50%, -100%);
            transition: opacity 0.1s ease;
            z-index: 15;
        }
        /* Killfeed / Event notifications */
        @keyframes popFade {
            0% { transform: scale(0.8) translateY(10px); opacity: 0; }
            15% { transform: scale(1.05) translateY(0); opacity: 1; }
            80% { transform: scale(1) translateY(0); opacity: 1; }
            100% { transform: scale(0.95) translateY(-10px); opacity: 0; }
        }
        .event-toast {
            animation: popFade 2.4s forwards;
        }
        /* Nano electric screen border when Nano is active */
        .nano-glow {
            box-shadow: inset 0 0 65px rgba(37, 99, 235, 0.65), inset 0 0 20px rgba(96, 165, 250, 0.8);
        }
        @keyframes floatNumberUp {
            0% { transform: translate(-50%, 0) scale(0.75); opacity: 0; }
            18% { transform: translate(-50%, -14px) scale(1.15); opacity: 1; }
            80% { transform: translate(-50%, -38px) scale(1); opacity: 0.95; }
            100% { transform: translate(-50%, -52px) scale(0.9); opacity: 0; }
        }
        .floating-combat-text {
            position: absolute;
            pointer-events: none;
            font-family: 'Orbitron', 'Noto Sans KR', sans-serif;
            font-weight: 900;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95);
            animation: floatNumberUp 1.05s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            z-index: 25;
            white-space: nowrap;
        }
    </style>
</head>
<body class="relative select-none text-white">

    <canvas id="game-canvas"></canvas>

    <!-- Floating World Labels Container (Bot HP bars, Sleep Zzz, Anti/Boost icons, Nano Lock-on) -->
    <div id="world-ui-layer" class="fixed inset-0 pointer-events-none overflow-hidden z-10"></div>

    <!-- Biotic Sniper Scope Overlay (Shown when Right-Click / Zoomed) -->
    <div id="scope-overlay" class="fixed inset-0 z-20 opacity-0 flex items-center justify-center scope-vignette">
        <svg class="w-[680px] h-[680px] max-w-[92vw] max-h-[92vw]" viewBox="0 0 600 600">
            <!-- Outer Cyan/Blue Scope Ring -->
            <circle cx="300" cy="300" r="245" fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-opacity="0.7" />
            <circle cx="300" cy="300" r="236" fill="none" stroke="#fbbf24" stroke-width="1" stroke-dasharray="18 12" stroke-opacity="0.6" />
            <!-- Ana's Signature Triangular Assist Reticle (For Allied Healing hitbox) -->
            <polygon points="300,175 185,375 415,375" fill="none" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.45" />
            <!-- Horizontal & Vertical Mil-Dots -->
            <line x1="55" y1="300" x2="260" y2="300" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.6" />
            <line x1="340" y1="300" x2="545" y2="300" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.6" />
            <line x1="300" y1="55" x2="300" y2="260" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.6" />
            <line x1="300" y1="340" x2="300" y2="545" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.6" />
            <!-- Tick marks -->
            <line x1="200" y1="294" x2="200" y2="306" stroke="#fbbf24" stroke-width="2" />
            <line x1="240" y1="296" x2="240" y2="304" stroke="#fbbf24" stroke-width="2" />
            <line x1="360" y1="296" x2="360" y2="304" stroke="#fbbf24" stroke-width="2" />
            <line x1="400" y1="294" x2="400" y2="306" stroke="#fbbf24" stroke-width="2" />
            <!-- Center Biotic Crosshair -->
            <circle cx="300" cy="300" r="16" fill="none" stroke="#fbbf24" stroke-width="1.8" stroke-opacity="0.85" />
            <circle cx="300" cy="300" r="3" fill="#38bdf8" />
            <!-- Telemetry Text -->
            <text x="315" y="160" fill="#38bdf8" font-family="Orbitron" font-size="11" opacity="0.8">BIOTIC OPTICS // 4.5X</text>
            <text x="195" y="395" fill="#fbbf24" font-family="Orbitron" font-size="10" opacity="0.75">HITSCAN MODE ACTIVE</text>
        </svg>
    </div>

    <div id="crosshair-layer" class="fixed inset-0 pointer-events-none flex items-center justify-center z-20">
        <!-- Standard Crosshair -->
        <div id="normal-crosshair" class="relative flex items-center justify-center">
            <div class="w-1.5 h-1.5 bg-cyan-300 rounded-full shadow-[0_0_6px_#22d3ee]"></div>
            <div class="absolute w-5 h-5 border border-yellow-300/70 rounded-full"></div>
            <div class="absolute w-3 h-0.5 bg-cyan-300/80 -left-4"></div>
            <div class="absolute w-3 h-0.5 bg-cyan-300/80 -right-4"></div>
            <div class="absolute h-3 w-0.5 bg-cyan-300/80 -top-4"></div>
            <div class="absolute h-3 w-0.5 bg-cyan-300/80 -bottom-4"></div>
        </div>
        <!-- Hitmarker / Healmarker X -->
        <div id="hit-marker" class="absolute opacity-0 transition-opacity duration-75">
            <svg class="w-9 h-9" viewBox="0 0 40 40">
                <line id="hm-1" x1="8" y1="8" x2="15" y2="15" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round"/>
                <line id="hm-2" x1="32" y1="8" x2="25" y2="15" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round"/>
                <line id="hm-3" x1="8" y1="32" x2="15" y2="25" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round"/>
                <line id="hm-4" x1="32" y1="32" x2="25" y2="25" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
        </div>
    </div>

    <!-- Screen Edge Glow Effect (Nano Boost / Self Biotic Heal) -->
    <div id="screen-fx" class="fixed inset-0 pointer-events-none z-10 transition-all duration-300"></div>

    <div class="fixed top-4 left-4 right-4 flex flex-wrap items-start justify-between gap-2 z-30 pointer-events-none">
        <!-- Top Left: Hero Info & Mode Controls -->
        <div class="flex flex-col gap-2 pointer-events-auto">
            <div class="bg-slate-900/85 border-l-4 border-blue-500 px-4 py-2.5 rounded-r-xl backdrop-blur-md shadow-xl flex items-center gap-4">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 text-[11px] font-bold bg-blue-600 text-white rounded ow-skew">SUPPORT</span>
                        <h1 class="text-lg sm:text-xl font-black tracking-wider text-white ow-font">ANA AMARI // 아나</h1>
                    </div>
                    <p id="mouse-status-text" class="text-xs text-cyan-300 mt-0.5">화면을 클릭하면 마우스 조준이 활성화됩니다 (ESC로 해제)</p>
                </div>
            </div>

            <!-- View & Pose Switcher Buttons -->
            <div class="flex flex-wrap gap-1.5">
                <button id="btn-cam-tps" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800/90 text-slate-200 border border-slate-600 hover:bg-slate-700 transition">
                    🎥 3인칭 숄더뷰 시점 (V)
                </button>
                <button id="btn-cam-fps" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800/90 text-slate-200 border border-slate-600 hover:bg-slate-700 transition">
                    🔫 1인칭 시점 (전용 총기·스킬 모션)
                </button>
                <button id="btn-cam-pose" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-400 text-slate-950 border border-white shadow hover:bg-amber-300 transition">
                    🏔️ 사진 원작 구도 시점 (C / 사격·스킬 가능)
                </button>
                <button id="btn-fill-ult" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-sky-500/20 text-sky-300 border border-sky-400/50 hover:bg-sky-500/40 transition">
                    ⚡ 궁극기 100% 충전
                </button>
            </div>

            <div class="flex flex-wrap items-center gap-3 bg-slate-950/80 border border-slate-700/80 px-3.5 py-1.5 rounded-xl backdrop-blur-md text-xs shadow-lg">
                <div class="flex items-center gap-1.5">
                    <span class="text-amber-300 font-bold">➕ 치유량:</span>
                    <span id="stat-heal" class="ow-font font-black text-white">0</span>
                </div>
                <div class="w-px h-3 bg-slate-700"></div>
                <div class="flex items-center gap-1.5">
                    <span class="text-purple-400 font-bold">💥 피해량:</span>
                    <span id="stat-dmg" class="ow-font font-black text-white">0</span>
                </div>
                <div class="w-px h-3 bg-slate-700"></div>
                <div class="flex items-center gap-1.5">
                    <span class="text-cyan-300 font-bold">💤 수면 적중:</span>
                    <span id="stat-sleep" class="ow-font font-black text-white">0</span>
                </div>
                <div class="w-px h-3 bg-slate-700"></div>
                <div class="flex items-center gap-1.5">
                    <span class="text-red-400 font-bold">🎯 처치:</span>
                    <span id="stat-elim" class="ow-font font-black text-white">0</span>
                </div>
            </div>
        </div>

        <!-- Top Center: Dynamic Voice / Combat Callout Banner -->
        <div id="combat-feed" class="flex flex-col items-center gap-1.5 pointer-events-none mx-auto mt-1"></div>

        <!-- Top Right: Controls Cheat Sheet -->
        <div class="hidden lg:block bg-slate-900/80 border border-slate-700/80 rounded-xl px-4 py-3 text-xs backdrop-blur-md shadow-xl pointer-events-auto">
            <div class="font-bold text-amber-400 mb-1.5 flex items-center justify-between">
                <span>조작 가이드 (CONTROLS)</span>
                <span class="text-[10px] text-slate-400">눈 덮인 훈련장</span>
            </div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-slate-200">
                <div><span class="text-cyan-400 font-bold">W A S D / 방향키</span> : 이동</div>
                <div><span class="text-cyan-400 font-bold">좌클릭</span> : 생체 소총 (아군 치유/적 피해)</div>
                <div><span class="text-cyan-400 font-bold">우클릭 (또는 Z)</span> : 저격 조준경 (히트스캔)</div>
                <div><span class="text-cyan-400 font-bold">Shift</span> : 수면총 (적 5초간 수면)</div>
                <div><span class="text-cyan-400 font-bold">E</span> : 생체 수류탄 (치유강화 / 치유차단)</div>
                <div><span class="text-cyan-400 font-bold">Q</span> : 나노 강화제 (아군 조준 후 사용)</div>
                <div><span class="text-cyan-400 font-bold">R</span> : 재장전 / <span class="text-cyan-400 font-bold">Space</span> : 점프</div>
                <div><span class="text-amber-300 font-bold">C</span> : 원작 일러스트 포즈 & 360° 회전</div>
            </div>
        </div>
    </div>

    <div class="fixed bottom-4 left-4 right-4 flex flex-col md:flex-row items-center md:items-end justify-between gap-4 z-30 pointer-events-none">

        <!-- Bottom Left: Ana Portrait & 250 HP Bar -->
        <div class="flex items-end gap-3 pointer-events-auto">
            <!-- Portrait Hexagon/Frame -->
            <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-gradient-to-b from-blue-900/90 to-slate-950/95 border-2 border-blue-400/80 shadow-[0_0_20px_rgba(37,99,235,0.4)] flex items-center justify-center overflow-hidden ow-skew">
                <!-- High-Detail SVG Portrait of Ana matching the screenshot -->
                <svg class="w-22 h-22 ow-unskew" viewBox="0 0 120 120">
                    <!-- Outer Dark Hood -->
                    <path d="M12,115 C10,50 24,10 60,10 C96,10 110,50 108,115 Z" fill="#1e222d" stroke="#334155" stroke-width="2"/>
                    <!-- Hood Top Silver Clasp with 2 Stripes -->
                    <polygon points="52,10 68,10 66,23 54,23" fill="#cbd5e1"/>
                    <rect x="56" y="12" width="2.2" height="9" fill="#334155"/>
                    <rect x="61.8" y="12" width="2.2" height="9" fill="#334155"/>
                    <!-- Hood Side Silver Rivet -->
                    <circle cx="26" cy="40" r="3.5" fill="#cbd5e1"/>
                    <!-- Inner Cobalt Blue Scarf -->
                    <path d="M26,110 C25,52 36,24 60,24 C84,24 95,52 94,110 Z" fill="#1d4ed8"/>
                    <!-- Warm Tan Face -->
                    <path d="M38,54 C38,38 82,38 82,54 C82,76 72,91 60,91 C48,91 38,76 38,54 Z" fill="#b87d59"/>
                    <!-- Eyepatch & Strap (Ana's Right Eye = Viewer's Left) -->
                    <line x1="34" y1="48" x2="66" y2="63" stroke="#0f172a" stroke-width="3"/>
                    <ellipse cx="49" cy="60" rx="8.5" ry="6.5" fill="#0f172a"/>
                    <!-- Iconic Layered Silver-White Hair Sweeping Over Right Eye -->
                    <path d="M36,42 C46,32 65,33 74,44 C64,45 58,56 44,69 C43,58 39,50 36,42 Z" fill="#f1f5f9"/>
                    <path d="M46,36 C56,34 65,37 68,45 C60,48 55,58 49,67 C49,55 48,44 46,36 Z" fill="#cbd5e1"/>
                    <!-- Left Eye (Viewer's Right) + Kohl Eyeliner + Horus Tattoo -->
                    <path d="M64,56 Q71,52 78,56 Q71,60 64,56 Z" fill="#ffffff" stroke="#0f172a" stroke-width="2"/>
                    <circle cx="71" cy="56" r="2.6" fill="#1e1b18"/>
                    <path d="M63,50 L79,47" stroke="#1e293b" stroke-width="2.6" stroke-linecap="round"/>
                    <!-- Eye of Horus Tattoo under Left Eye -->
                    <path d="M64,62 Q71,65 79,60 M71,64 L70,71" stroke="#0f172a" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                    <!-- Nose & Lips -->
                    <path d="M60,55 L58,69 L63,70" stroke="#8c583a" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                    <path d="M53,79 Q60,82 67,79" stroke="#6e3b3b" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                </svg>
                <div id="self-buff-badge" class="hidden absolute bottom-1 right-1 px-1.5 py-0.5 text-[9px] font-black bg-amber-400 text-slate-950 rounded">
                    치유강화
                </div>
            </div>

            <!-- HP Readout & Pip Bars -->
            <div class="flex flex-col mb-1">
                <div class="flex items-baseline gap-1.5 ow-font">
                    <span id="player-hp-num" class="text-3xl sm:text-4xl font-black text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)]">250</span>
                    <span class="text-lg text-slate-400 font-bold">/ 250</span>
                </div>
                <div id="player-hp-pips" class="flex items-center mt-1 bg-slate-950/70 p-1.5 rounded-lg border border-white/15 backdrop-blur-sm">
                    <!-- 10 Pips (25 HP each) generated by JS -->
                </div>
            </div>
        </div>

        <!-- Bottom Center: Ultimate Meter (Nano Boost Q) -->
        <div class="flex flex-col items-center pointer-events-auto">
            <button id="btn-ult-q" class="relative w-20 h-20 rounded-full flex items-center justify-center transition-transform active:scale-95 group">
                <!-- Circular Progress SVG -->
                <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="42" fill="rgba(15,23,42,0.85)" stroke="rgba(255,255,255,0.2)" stroke-width="6"/>
                    <circle id="ult-ring" cx="50" cy="50" r="42" fill="none" stroke="#38bdf8" stroke-width="7"
                        stroke-dasharray="264" stroke-dashoffset="0" stroke-linecap="round" class="transition-all duration-200"/>
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span id="ult-percent-text" class="ow-font text-xl font-black text-cyan-300 drop-shadow">100%</span>
                    <span class="text-[10px] font-bold text-amber-300">나노 강화제</span>
                </div>
            </button>
            <div class="mt-1 px-2.5 py-0.5 bg-slate-900/90 border border-cyan-400/50 rounded text-xs font-black text-cyan-300">
                Q (아군 조준)
            </div>
        </div>

        <!-- Bottom Right: Abilities (Sleep Dart, Biotic Grenade, Scope) & Ammo Counter -->
        <div class="flex items-end gap-3 pointer-events-auto">
            <!-- Ability Icons -->
            <div class="flex items-center gap-2">
                <!-- L-Shift: Sleep Dart -->
                <button id="btn-skill-shift" class="ability-box ready" title="수면총 (Shift)">
                    <div class="ow-unskew flex flex-col items-center">
                        <!-- Sleep Dart Icon -->
                        <svg class="w-7 h-7 text-cyan-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 12h11m0 0l-3-3m3 3l-3 3M14 9h4l3 3-3 3h-4"/>
                            <text x="14" y="8" font-size="6" fill="#fde047" stroke="none" font-weight="bold">Zzz</text>
                        </svg>
                        <span id="cd-shift" class="text-[11px] font-bold text-white mt-0.5">수면총</span>
                    </div>
                    <span class="absolute -bottom-2.5 px-1.5 py-0.2 bg-slate-900 border border-slate-500 rounded text-[10px] font-bold text-amber-300 ow-unskew">SHIFT</span>
                </button>

                <!-- E: Biotic Grenade -->
                <button id="btn-skill-e" class="ability-box ready" title="생체 수류탄 (E)">
                    <div class="ow-unskew flex flex-col items-center">
                        <!-- Biotic Grenade Icon -->
                        <svg class="w-7 h-7 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="7" y="6" width="10" height="14" rx="4" stroke="#fbbf24"/>
                            <path d="M9 3h6M12 3v3M12 10v6M9 13h6" stroke="#c084fc"/>
                        </svg>
                        <span id="cd-e" class="text-[11px] font-bold text-white mt-0.5">생체탄</span>
                    </div>
                    <span class="absolute -bottom-2.5 px-1.5 py-0.2 bg-slate-900 border border-slate-500 rounded text-[10px] font-bold text-amber-300 ow-unskew">E</span>
                </button>

                <!-- RMB: Sniper Scope Toggle -->
                <button id="btn-skill-scope" class="ability-box ready" title="조준경 저격 (우클릭 / Z)">
                    <div class="ow-unskew flex flex-col items-center">
                        <svg class="w-7 h-7 text-sky-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="8"/>
                            <line x1="12" y1="2" x2="12" y2="6"/>
                            <line x1="12" y1="18" x2="12" y2="22"/>
                            <line x1="2" y1="12" x2="6" y2="12"/>
                            <line x1="18" y1="12" x2="22" y2="12"/>
                        </svg>
                        <span class="text-[11px] font-bold text-white mt-0.5">조준경</span>
                    </div>
                    <span class="absolute -bottom-2.5 px-1.5 py-0.2 bg-slate-900 border border-slate-500 rounded text-[10px] font-bold text-amber-300 ow-unskew">우클릭</span>
                </button>
            </div>

            <!-- Biotic Rifle Ammo Readout -->
            <div class="bg-slate-900/85 border-r-4 border-cyan-400 px-4 py-2 rounded-l-xl backdrop-blur-md ow-skew flex items-center gap-3">
                <div class="ow-unskew text-right">
                    <div class="flex items-baseline justify-end gap-1 ow-font">
                        <span id="ammo-current" class="text-3xl sm:text-4xl font-black text-white">10</span>
                        <span class="text-base text-slate-400 font-bold">/ 10</span>
                    </div>
                    <div class="text-[10px] font-bold text-cyan-300 tracking-wider">생체 소총 (R 재장전)</div>
                </div>
            </div>
        </div>
    </div>

    <div id="pose-showcase-banner" class="fixed top-20 left-1/2 -translate-x-1/2 bg-slate-900/90 border border-amber-400/80 px-5 py-2.5 rounded-2xl backdrop-blur-md shadow-2xl z-30 text-center pointer-events-auto">
        <div class="text-amber-300 font-black text-xs sm:text-sm">🏔️ 원작 화보 구도 시점 (마우스 드래그: 360° 회전 / 휠: 줌 / 좌클릭·Shift·E·Q: 즉시 사격 및 스킬 시연!)</div>
        <div class="flex items-center justify-center gap-2 mt-1.5">
            <button id="btn-reset-photo-angle" class="px-3 py-1 bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-black rounded-lg transition">
                📸 사진 원본 각도로 정렬
            </button>
            <button id="btn-exit-pose" class="px-3 py-1 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-lg transition">
                🎯 3인칭 숄더뷰 전투 시점으로 전환 (V / C)
            </button>
        </div>
    </div>

    <script>
        /* ============================================================================
         * 1. PROCEDURAL WEB AUDIO SYNTHESIZER (No external audio files needed)
         * ============================================================================ */
        class AnaSoundEngine {
            constructor() {
                this.ctx = null;
            }
            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) this.ctx = new AudioCtx();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }
            // Biotic Rifle pneumatic dart shot ("Pfft-tchk!")
            playRifleShot(isScoped = false) {
                this.init();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;

                // Pneumatic air burst
                const bufferSize = this.ctx.sampleRate * 0.14;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (this.ctx.sampleRate * 0.035));
                }
                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = this.ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.setValueAtTime(isScoped ? 1800 : 2400, now);
                filter.Q.setValueAtTime(1.8, now);

                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.35, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.14);

                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);
                noise.start(now);

                // Syringe mechanical punch
                const osc = this.ctx.createOscillator();
                const oscGain = this.ctx.createGain();
                osc.type = isScoped ? 'sawtooth' : 'triangle';
                osc.frequency.setValueAtTime(isScoped ? 520 : 380, now);
                osc.frequency.exponentialRampToValueAtTime(95, now + 0.09);
                oscGain.gain.setValueAtTime(0.25, now);
                oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
                osc.connect(oscGain);
                oscGain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.09);
            }

            // Signature Ana 3-tick healing or damage-over-time sound ("Chik-chik-chik!")
            playBioticTicks(isHeal = true) {
                this.init();
                if (!this.ctx) return;
                const baseFreq = isHeal ? 1150 : 420;
                for (let i = 0; i < 3; i++) {
                    const t = this.ctx.currentTime + i * 0.085;
                    const osc = this.ctx.createOscillator();
                    const g = this.ctx.createGain();
                    osc.type = isHeal ? 'sine' : 'sawtooth';
                    osc.frequency.setValueAtTime(baseFreq + i * (isHeal ? 160 : -35), t);
                    g.gain.setValueAtTime(0.14, t);
                    g.gain.exponentialRampToValueAtTime(0.001, t + 0.065);
                    osc.connect(g);
                    g.connect(this.ctx.destination);
                    osc.start(t);
                    osc.stop(t + 0.065);
                }
            }

            // Sleep Dart ("Shhk-PEW!")
            playSleepDart() {
                this.init();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const g = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(980, now);
                osc.frequency.exponentialRampToValueAtTime(220, now + 0.18);
                g.gain.setValueAtTime(0.3, now);
                g.gain.exponentialRampToValueAtTime(0.01, now + 0.18);
                osc.connect(g);
                g.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.18);
            }

            // Biotic Grenade Shatter ("Kshhh-ting!")
            playGrenadeSplash() {
                this.init();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                // High glass chime + splash
                [1480, 1920, 2450].forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const g = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.02);
                    osc.frequency.exponentialRampToValueAtTime(freq * 0.7, now + 0.28);
                    g.gain.setValueAtTime(0.15, now + idx * 0.02);
                    g.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
                    osc.connect(g);
                    g.connect(this.ctx.destination);
                    osc.start(now + idx * 0.02);
                    osc.stop(now + 0.29);
                });
            }

            // Nano Boost Electric Surge ("BZZZZT-POW!")
            playNanoBoost() {
                this.init();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const g = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, now);
                osc.frequency.exponentialRampToValueAtTime(880, now + 0.35);
                g.gain.setValueAtTime(0.28, now);
                g.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
                osc.connect(g);
                g.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.45);
            }

            // Reload click
            playReload() {
                this.init();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                [0, 0.25].forEach((offset, i) => {
                    const osc = this.ctx.createOscillator();
                    const g = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(i === 0 ? 300 : 620, now + offset);
                    g.gain.setValueAtTime(0.2, now + offset);
                    g.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.06);
                    osc.connect(g);
                    g.connect(this.ctx.destination);
                    osc.start(now + offset);
                    osc.stop(now + offset + 0.06);
                });
            }
        }

        const sfx = new AnaSoundEngine();
    </script>

    <script>
        /* ============================================================================
         * 2. ULTRA-DETAILED 3D ANA AMARI & BIOTIC RIFLE BUILDER (Exact Match to Photo)
         * ============================================================================ */
        function createAnaFaceTexture() {
            const c = document.createElement('canvas');
            c.width = 1024;
            c.height = 1024;
            const ctx = c.getContext('2d');

            // Base warm Egyptian olive-tan skin tone
            const skinGrad = ctx.createRadialGradient(512, 500, 80, 512, 520, 480);
            skinGrad.addColorStop(0, '#d29973');
            skinGrad.addColorStop(0.55, '#bd815c');
            skinGrad.addColorStop(1, '#8f5b3c');
            ctx.fillStyle = skinGrad;
            ctx.fillRect(0, 0, 1024, 1024);

            // Cheekbone & jaw contour shading (Overwatch stylized painter look)
            ctx.fillStyle = 'rgba(115, 62, 38, 0.35)';
            ctx.beginPath();
            ctx.ellipse(350, 620, 90, 140, 0.35, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.ellipse(674, 620, 90, 140, -0.35, 0, Math.PI * 2);
            ctx.fill();

            // Subtle veteran nasolabial / expression lines
            ctx.strokeStyle = 'rgba(110, 58, 35, 0.55)';
            ctx.lineWidth = 6;
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(465, 585);
            ctx.quadraticCurveTo(435, 635, 442, 685);
            ctx.moveTo(559, 585);
            ctx.quadraticCurveTo(589, 635, 582, 685);
            ctx.stroke();

            // Nose shading & nostrils (center UV around x=512, y=545)
            ctx.fillStyle = 'rgba(105, 52, 30, 0.45)';
            ctx.beginPath();
            ctx.moveTo(492, 460);
            ctx.lineTo(476, 575);
            ctx.lineTo(512, 592);
            ctx.closePath();
            ctx.fill();

            ctx.fillStyle = '#5c2c16';
            ctx.beginPath();
            ctx.ellipse(494, 582, 11, 6, 0.3, 0, Math.PI * 2);
            ctx.ellipse(530, 582, 11, 6, -0.3, 0, Math.PI * 2);
            ctx.fill();

            // Sculpted Lips (Terracotta / Dark Plum-Rose like in the screenshot)
            // Upper lip
            ctx.fillStyle = '#7c423c';
            ctx.beginPath();
            ctx.moveTo(448, 658);
            ctx.quadraticCurveTo(485, 642, 512, 650);
            ctx.quadraticCurveTo(539, 642, 576, 658);
            ctx.quadraticCurveTo(512, 666, 448, 658);
            ctx.fill();

            // Lower lip with subtle highlight
            const lipGrad = ctx.createLinearGradient(512, 658, 512, 690);
            lipGrad.addColorStop(0, '#9e584f');
            lipGrad.addColorStop(0.6, '#b36a60');
            lipGrad.addColorStop(1, '#703832');
            ctx.fillStyle = lipGrad;
            ctx.beginPath();
            ctx.moveTo(452, 660);
            ctx.quadraticCurveTo(512, 665, 572, 660);
            ctx.quadraticCurveTo(548, 692, 512, 692);
            ctx.quadraticCurveTo(476, 692, 452, 660);
            ctx.fill();

            // Lip parting line
            ctx.strokeStyle = '#3d1916';
            ctx.lineWidth = 4.5;
            ctx.beginPath();
            ctx.moveTo(446, 659);
            ctx.quadraticCurveTo(512, 666, 578, 659);
            ctx.stroke();

            // --- ANA'S LEFT EYE (Viewer's Right Side -> UV x ~ 595, y ~ 465) ---
            // Fierce Angled Silver-Charcoal Eyebrow
            ctx.fillStyle = '#1e293b';
            ctx.beginPath();
            ctx.moveTo(542, 422);
            ctx.quadraticCurveTo(598, 396, 662, 412);
            ctx.lineTo(656, 428);
            ctx.quadraticCurveTo(596, 415, 546, 435);
            ctx.closePath();
            ctx.fill();

            // Heavy Egyptian Black Kohl Eyeshadow & Winged Eyeliner
            ctx.fillStyle = '#090d16';
            ctx.beginPath();
            ctx.moveTo(548, 466);
            ctx.quadraticCurveTo(595, 432, 658, 455);
            ctx.lineTo(672, 448); // Wing tip
            ctx.quadraticCurveTo(642, 488, 595, 488);
            ctx.quadraticCurveTo(564, 484, 548, 466);
            ctx.closePath();
            ctx.fill();

            // Crisp White Sclera
            ctx.fillStyle = '#f8fafc';
            ctx.beginPath();
            ctx.moveTo(558, 465);
            ctx.quadraticCurveTo(596, 444, 638, 460);
            ctx.quadraticCurveTo(600, 480, 558, 465);
            ctx.closePath();
            ctx.fill();

            // Dark Warm Brown Iris & Pupil (Looking slightly towards rifle target)
            ctx.fillStyle = '#2e1d12';
            ctx.beginPath();
            ctx.arc(596, 462, 16, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#09090b';
            ctx.beginPath();
            ctx.arc(596, 462, 8.5, 0, Math.PI * 2);
            ctx.fill();

            // Sharp Eye Specular Highlight
            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(590, 456, 4.2, 0, Math.PI * 2);
            ctx.arc(603, 466, 2.2, 0, Math.PI * 2);
            ctx.fill();

            // --- ICONIC EYE OF HORUS (WEDJAT) TATTOO UNDER HER LEFT EYE ---
            ctx.strokeStyle = '#0f172a';
            ctx.lineWidth = 6.5;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            // Curved lower Horus bar sweeping out toward temple
            ctx.beginPath();
            ctx.moveTo(558, 494);
            ctx.quadraticCurveTo(602, 512, 658, 484);
            ctx.stroke();
            // Vertical Horus drop-mark & curl on cheek
            ctx.beginPath();
            ctx.moveTo(602, 502);
            ctx.lineTo(596, 544);
            ctx.quadraticCurveTo(594, 556, 582, 552);
            ctx.stroke();
            // Outer falcon tail mark
            ctx.beginPath();
            ctx.moveTo(632, 496);
            ctx.lineTo(654, 522);
            ctx.stroke();

            // --- ANA'S RIGHT EYE (Viewer's Left -> Covered by Eyepatch, add strap shadow) ---
            ctx.fillStyle = '#090d16';
            ctx.beginPath();
            ctx.ellipse(425, 465, 54, 38, -0.1, 0, Math.PI * 2);
            ctx.fill();

            const tex = new THREE.CanvasTexture(c);
            tex.needsUpdate = true;
            return tex;
        }

        function createAnaCharacterModel() {
            const root = new THREE.Group();

            // Carefully Matched Overwatch Reference Palette (from image_58b867.png)
            const matHoodCharcoal = new THREE.MeshStandardMaterial({ color: 0x222631, roughness: 0.72, metalness: 0.18 });
            const matHoodInnerDark = new THREE.MeshStandardMaterial({ color: 0x14171f, roughness: 0.85, metalness: 0.1, side: THREE.DoubleSide });
            const matHijabBlue = new THREE.MeshStandardMaterial({ color: 0x1d56d8, roughness: 0.48, metalness: 0.15 });
            const matRifleBlue = new THREE.MeshStandardMaterial({ color: 0x2255dd, roughness: 0.32, metalness: 0.42 });
            const matSkinSolid = new THREE.MeshStandardMaterial({ color: 0xc28560, roughness: 0.6, metalness: 0.05 });
            const matFaceTextured = new THREE.MeshStandardMaterial({
                map: createAnaFaceTexture(),
                roughness: 0.58,
                metalness: 0.04
            });
            const matHairWhite = new THREE.MeshStandardMaterial({ color: 0xeef2f6, roughness: 0.35, metalness: 0.12 });
            const matHairSilver = new THREE.MeshStandardMaterial({ color: 0xcbd5e1, roughness: 0.4, metalness: 0.18 });
            const matMetalSilver = new THREE.MeshStandardMaterial({ color: 0xd8dee9, roughness: 0.22, metalness: 0.88 });
            const matGunBlack = new THREE.MeshStandardMaterial({ color: 0x16181d, roughness: 0.38, metalness: 0.72 });
            const matCeramWhite = new THREE.MeshStandardMaterial({ color: 0xeaeff5, roughness: 0.28, metalness: 0.22 });
            const matSageOlive = new THREE.MeshStandardMaterial({ color: 0x576052, roughness: 0.75, metalness: 0.12 });
            const matLeatherBlack = new THREE.MeshStandardMaterial({ color: 0x181a20, roughness: 0.55, metalness: 0.25 });
            const matBioticAmber = new THREE.MeshStandardMaterial({
                color: 0xf59e0b,
                emissive: 0xd97706,
                emissiveIntensity: 0.65,
                roughness: 0.2,
                metalness: 0.3
            });
            const matCyanOptic = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });

            // ========================================================================
            // 1. PELVIS, CROUCHED LEGS & TACTICAL FRONT TABARD (Exact lower half of photo)
            // ========================================================================
            const pelvis = new THREE.Group();
            pelvis.position.y = 0.92;
            root.add(pelvis);

            const hipBlock = new THREE.Mesh(new THREE.BoxGeometry(0.46, 0.22, 0.34), matHoodCharcoal);
            pelvis.add(hipBlock);

            // Left Hip Sleep Dart Pistol Holster & Right Hip Biotic Grenade Pouches
            const holsterGroup = new THREE.Group();
            holsterGroup.position.set(0.25, -0.06, 0.02);
            holsterGroup.rotation.z = 0.18;
            pelvis.add(holsterGroup);
            const holsterBox = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.22, 0.16), matLeatherBlack);
            holsterGroup.add(holsterBox);
            const holsterStripe = new THREE.Mesh(new THREE.BoxGeometry(0.085, 0.05, 0.165), matHijabBlue);
            holsterStripe.position.y = 0.05;
            holsterGroup.add(holsterStripe);

            // Right Hip Spare Biotic Grenade Canisters on Belt
            const hipNadeGroup = new THREE.Group();
            hipNadeGroup.position.set(-0.25, -0.02, 0.05);
            pelvis.add(hipNadeGroup);
            [-0.04, 0.04].forEach(zOff => {
                const miniNade = new THREE.Mesh(new THREE.CylinderGeometry(0.032, 0.032, 0.11, 10), matBioticAmber);
                miniNade.position.set(0, 0, zOff);
                hipNadeGroup.add(miniNade);
                const miniCap = new THREE.Mesh(new THREE.CylinderGeometry(0.036, 0.036, 0.025, 10), matRifleBlue);
                miniCap.position.set(0, 0.05, zOff);
                hipNadeGroup.add(miniCap);
            });

            // Dark Segmented Waist Tabard / Apron hanging in front
            const tabardGroup = new THREE.Group();
            tabardGroup.position.set(0, -0.06, 0.17);
            pelvis.add(tabardGroup);

            const mainTabard = new THREE.Mesh(new THREE.BoxGeometry(0.30, 0.52, 0.05), matLeatherBlack);
            mainTabard.position.set(0, -0.24, 0);
            tabardGroup.add(mainTabard);

            // Vertical quilt lines on dark tabard
            for (let i = -1; i <= 1; i++) {
                const rib = new THREE.Mesh(new THREE.BoxGeometry(0.065, 0.48, 0.06), matHoodCharcoal);
                rib.position.set(i * 0.085, -0.24, 0.005);
                tabardGroup.add(rib);
            }

            // Two Blue-Bordered Hanging Belt Straps with Silver Tips (Visible at bottom-left of photo!)
            [-0.045, 0.055].forEach((xOff, idx) => {
                const strapLoop = new THREE.Mesh(new THREE.BoxGeometry(0.065, 0.58, 0.065), matHijabBlue);
                strapLoop.position.set(xOff, -0.28 - idx * 0.04, 0.02);
                strapLoop.rotation.z = idx === 0 ? -0.05 : 0.08;
                tabardGroup.add(strapLoop);

                const strapInner = new THREE.Mesh(new THREE.BoxGeometry(0.042, 0.56, 0.07), matLeatherBlack);
                strapInner.position.copy(strapLoop.position);
                strapInner.rotation.copy(strapLoop.rotation);
                tabardGroup.add(strapInner);

                const buckleEnd = new THREE.Mesh(new THREE.BoxGeometry(0.068, 0.06, 0.074), matMetalSilver);
                buckleEnd.position.set(xOff, -0.55 - idx * 0.04, 0.02);
                tabardGroup.add(buckleEnd);
            });

            // Flowing Olive & Charcoal Sniper Trench Coat Skirts (Flared around her wide sniper stance)
            function createCoatSidePanel(isLeft) {
                const side = isLeft ? 1 : -1;
                const skirtGroup = new THREE.Group();
                skirtGroup.position.set(side * 0.21, -0.04, -0.02);
                skirtGroup.rotation.z = side * 0.28;
                skirtGroup.rotation.x = 0.14;

                const outerCoat = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.78, 0.42), matSageOlive);
                outerCoat.position.set(0, -0.36, 0);
                skirtGroup.add(outerCoat);

                const blueTrimEdge = new THREE.Mesh(new THREE.BoxGeometry(0.125, 0.78, 0.06), matHijabBlue);
                blueTrimEdge.position.set(0, -0.36, 0.19);
                skirtGroup.add(blueTrimEdge);

                const darkInnerEdge = new THREE.Mesh(new THREE.BoxGeometry(0.13, 0.78, 0.12), matHoodCharcoal);
                darkInnerEdge.position.set(0, -0.36, 0.14);
                skirtGroup.add(darkInnerEdge);

                return skirtGroup;
            }
            const leftCoatPanel = createCoatSidePanel(true);
            const rightCoatPanel = createCoatSidePanel(false);
            pelvis.add(leftCoatPanel);
            pelvis.add(rightCoatPanel);

            // Articulated Crouching/Striding Legs with Knee & Ankle Joints
            function createLeg(isLeft) {
                const side = isLeft ? 1 : -1;
                const legGroup = new THREE.Group();
                legGroup.position.set(side * 0.15, -0.06, 0.02);

                // Olive-grey padded thigh pants
                const thigh = new THREE.Mesh(new THREE.CylinderGeometry(0.125, 0.105, 0.44, 14), matSageOlive);
                thigh.position.y = -0.20;
                legGroup.add(thigh);

                // Dark thigh strap & armor plate
                const thighStrap = new THREE.Mesh(new THREE.CylinderGeometry(0.124, 0.120, 0.07, 14), matLeatherBlack);
                thighStrap.position.y = -0.22;
                legGroup.add(thighStrap);

                // Knee Pivot Group for realistic walking knee bend
                const kneeGroup = new THREE.Group();
                kneeGroup.position.set(0, -0.42, 0.0);
                legGroup.add(kneeGroup);

                const kneePad = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.15, 0.17), matLeatherBlack);
                kneePad.position.set(0, 0, 0.03);
                kneeGroup.add(kneePad);

                const kneeCapSilver = new THREE.Mesh(new THREE.BoxGeometry(0.09, 0.08, 0.03), matMetalSilver);
                kneeCapSilver.position.set(0, 0, 0.115);
                kneeGroup.add(kneeCapSilver);

                const shin = new THREE.Mesh(new THREE.CylinderGeometry(0.095, 0.078, 0.42, 12), matHoodCharcoal);
                shin.position.y = -0.22;
                kneeGroup.add(shin);

                // Shin wrap straps
                const shinWrap = new THREE.Mesh(new THREE.CylinderGeometry(0.092, 0.086, 0.14, 12), matHijabBlue);
                shinWrap.position.y = -0.26;
                kneeGroup.add(shinWrap);

                const bootGroup = new THREE.Group();
                bootGroup.position.set(0, -0.42, 0.04);
                kneeGroup.add(bootGroup);

                const boot = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.13, 0.27), matLeatherBlack);
                bootGroup.add(boot);

                legGroup.userData = { kneeGroup, bootGroup };
                return legGroup;
            }
            const leftLeg = createLeg(true);
            const rightLeg = createLeg(false);
            pelvis.add(leftLeg);
            pelvis.add(rightLeg);

            // ========================================================================
            // 2. TORSO, UTILITY BELT, POUCHES & LAYERED NECK SCARF
            // ========================================================================
            const torso = new THREE.Group();
            torso.position.y = 0.10;
            pelvis.add(torso);

            // Flowing Back Sniper Cape / Cloak with Cobalt Blue Trim
            const backCapeGroup = new THREE.Group();
            backCapeGroup.position.set(0, 0.46, -0.15);
            torso.add(backCapeGroup);
            const backCapeMain = new THREE.Mesh(new THREE.BoxGeometry(0.46, 0.92, 0.05), matHoodCharcoal);
            backCapeMain.position.set(0, -0.44, -0.04);
            backCapeMain.rotation.x = 0.15;
            backCapeGroup.add(backCapeMain);
            const backCapeTrim = new THREE.Mesh(new THREE.BoxGeometry(0.48, 0.08, 0.055), matHijabBlue);
            backCapeTrim.position.set(0, -0.86, -0.10);
            backCapeTrim.rotation.x = 0.15;
            backCapeGroup.add(backCapeTrim);

            // Core Upper Coat Body
            const upperBody = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.22, 0.56, 16), matHoodCharcoal);
            upperBody.position.y = 0.28;
            torso.add(upperBody);

            // Sage-Olive Tactical Jacket Vest Panels & Shoulder Armor Pads
            const vestChest = new THREE.Mesh(new THREE.BoxGeometry(0.48, 0.40, 0.31), matSageOlive);
            vestChest.position.set(0, 0.30, 0.01);
            torso.add(vestChest);

            // Shoulder Pads with White/Blue Overwatch Trim (Visible on her shoulders in photo!)
            [-1, 1].forEach(side => {
                const padGroup = new THREE.Group();
                padGroup.position.set(side * 0.28, 0.48, 0.0);
                padGroup.rotation.z = -side * 0.25;

                const padBase = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.12, 0.26), matSageOlive);
                padGroup.add(padBase);

                const padWhiteTrim = new THREE.Mesh(new THREE.BoxGeometry(0.17, 0.04, 0.27), matCeramWhite);
                padWhiteTrim.position.y = 0.045;
