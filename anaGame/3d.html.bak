            // Tapered silver barrel collar
            const muzzleBase = new THREE.Mesh(new THREE.CylinderGeometry(0.038, 0.029, 0.14, 16), matMetalSilver);
            muzzleBase.rotation.x = Math.PI / 2;
            muzzleGroup.add(muzzleBase);

            // Upper & Lower Forked Prongs with side cutouts
            const prongTop = new THREE.Mesh(new THREE.BoxGeometry(0.052, 0.022, 0.22), matMetalSilver);
            prongTop.position.set(0, 0.028, 0.15);
            muzzleGroup.add(prongTop);

            const prongBot = new THREE.Mesh(new THREE.BoxGeometry(0.052, 0.022, 0.22), matMetalSilver);
            prongBot.position.set(0, -0.028, 0.15);
            muzzleGroup.add(prongBot);

            // Bridged tip of the muzzle brake
            const prongBridge = new THREE.Mesh(new THREE.BoxGeometry(0.052, 0.078, 0.032), matMetalSilver);
            prongBridge.position.set(0, 0, 0.25);
            muzzleGroup.add(prongBridge);

            const muzzlePoint = new THREE.Object3D();
            muzzlePoint.position.set(0, 0, 0.28);
            muzzleGroup.add(muzzlePoint);

            // 3D Muzzle Flash Burst Mesh (Flashes when firing!)
            const muzzleFlashMat = new THREE.MeshBasicMaterial({
                color: 0xfde047,
                transparent: true,
                opacity: 0.0,
                depthWrite: false
            });
            const muzzleFlashMesh = new THREE.Mesh(new THREE.ConeGeometry(0.09, 0.35, 8), muzzleFlashMat);
            muzzleFlashMesh.rotation.x = Math.PI / 2;
            muzzleFlashMesh.position.set(0, 0, 0.42);
            muzzleGroup.add(muzzleFlashMesh);

            // H. Wide Curved Olive-Grey Rifle Sling / Strap (Hanging in a deep U-loop under her hands!)
            const strapMountRear = new THREE.Mesh(new THREE.TorusGeometry(0.028, 0.007, 8, 12), matMetalSilver);
            strapMountRear.position.set(0, -0.17, -0.14);
            rifleGroup.add(strapMountRear);

            const strapMountFront = new THREE.Mesh(new THREE.BoxGeometry(0.055, 0.05, 0.045), matMetalSilver);
            strapMountFront.position.set(0, -0.075, 0.56);
            rifleGroup.add(strapMountFront);

            const strapCurve = new THREE.CatmullRomCurve3([
                new THREE.Vector3(0.0, -0.18, -0.14),
                new THREE.Vector3(0.02, -0.42, -0.06),
                new THREE.Vector3(0.04, -0.58, 0.14),
                new THREE.Vector3(0.04, -0.54, 0.36),
                new THREE.Vector3(0.02, -0.34, 0.52),
                new THREE.Vector3(0.0, -0.09, 0.56)
            ]);
            const strapGeo = new THREE.TubeGeometry(strapCurve, 36, 0.024, 10, false);
            // Flatten the strap slightly into a realistic woven belt cross-section
            strapGeo.scale(0.55, 1.0, 1.0);
            const strapMesh = new THREE.Mesh(strapGeo, matSageOlive);
            rifleGroup.add(strapMesh);

            // Inner dark lining of the sling strap for extra depth
            const strapInnerGeo = new THREE.TubeGeometry(strapCurve, 36, 0.021, 10, false);
            strapInnerGeo.scale(0.45, 0.96, 0.98);
            const strapInnerMesh = new THREE.Mesh(strapInnerGeo, matLeatherBlack);
            strapInnerMesh.position.x = -0.006;
            rifleGroup.add(strapInnerMesh);

            // Enable shadows on all meshes
            root.traverse(obj => {
                if (obj.isMesh) {
                    obj.castShadow = true;
                    obj.receiveShadow = true;
                }
            });

            return {
                root,
                pelvis,
                torso,
                headGroup,
                leftLeg,
                rightLeg,
                leftCoatPanel,
                rightCoatPanel,
                backCapeGroup,
                leftShoulder,
                leftElbow,
                lHand,
                sleepGauntlet,
                heldGrenadeProp,
                rightShoulder,
                rightElbow,
                rifleGroup,
                gripCanister,
                boltCarrierGroup,
                muzzlePoint,
                muzzleFlashMesh,
                muzzleFlashMat,
                bioticChamber
            };
        }

        /* ============================================================================
         * 2B. FIRST-PERSON (FPS) VIEWMODEL RIG (1인칭 총기, 노리쇠, 수면총, 생체 수류탄 손 모션)
         * ============================================================================ */
        function createFirstPersonViewModel() {
            const fpsRoot = new THREE.Group();

            const matRifleBlue = new THREE.MeshStandardMaterial({ color: 0x2255dd, roughness: 0.3, metalness: 0.45 });
            const matCeramWhite = new THREE.MeshStandardMaterial({ color: 0xeaeff5, roughness: 0.25, metalness: 0.22 });
            const matGunBlack = new THREE.MeshStandardMaterial({ color: 0x16181d, roughness: 0.35, metalness: 0.75 });
            const matMetalSilver = new THREE.MeshStandardMaterial({ color: 0xd8dee9, roughness: 0.2, metalness: 0.88 });
            const matSageOlive = new THREE.MeshStandardMaterial({ color: 0x576052, roughness: 0.72, metalness: 0.12 });
            const matLeatherBlack = new THREE.MeshStandardMaterial({ color: 0x181a20, roughness: 0.5, metalness: 0.25 });
            const matBioticAmber = new THREE.MeshStandardMaterial({
                color: 0xf59e0b,
                emissive: 0xd97706,
                emissiveIntensity: 0.85,
                roughness: 0.15,
                metalness: 0.3
            });
            const matCyanOptic = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });
            const matPurpleCore = new THREE.MeshBasicMaterial({ color: 0xa855f7 });

            // 1. RIGHT SIDE: 1ST-PERSON BIOTIC RIFLE & RIGHT HAND
            const gunPivot = new THREE.Group();
            gunPivot.position.set(0.27, -0.25, -0.46);
            fpsRoot.add(gunPivot);

            // White Lower Receiver & Grip
            const lowerRec = new THREE.Mesh(new THREE.BoxGeometry(0.082, 0.105, 0.48), matCeramWhite);
            lowerRec.position.set(0, -0.02, 0.02);
            gunPivot.add(lowerRec);

            // Detachable Magazine Canister (Animated during Reload!)
            const fpsMagazine = new THREE.Group();
            fpsMagazine.position.set(0, -0.095, 0.06);
            fpsMagazine.rotation.x = 0.42;
            gunPivot.add(fpsMagazine);
            const magCyl = new THREE.Mesh(new THREE.CylinderGeometry(0.038, 0.035, 0.17, 14), matCeramWhite);
            fpsMagazine.add(magCyl);
            const magBlueCap = new THREE.Mesh(new THREE.CylinderGeometry(0.040, 0.037, 0.045, 14), matRifleBlue);
            magBlueCap.position.y = -0.07;
            fpsMagazine.add(magBlueCap);

            // Cobalt-Blue Upper Receiver Shroud
            const upperRec = new THREE.Mesh(new THREE.BoxGeometry(0.092, 0.088, 0.62), matRifleBlue);
            upperRec.position.set(0, 0.055, -0.06);
            gunPivot.add(upperRec);

            // Glowing Biotic Syringe Chamber & Internal Pumping Plunger
            const chamberSlot = new THREE.Mesh(new THREE.BoxGeometry(0.095, 0.048, 0.22), matGunBlack);
            chamberSlot.position.set(0, 0.028, -0.02);
            gunPivot.add(chamberSlot);

            const fpsBioticVial = new THREE.Mesh(new THREE.CylinderGeometry(0.024, 0.024, 0.20, 14), matBioticAmber);
            fpsBioticVial.rotation.x = Math.PI / 2;
            fpsBioticVial.position.set(0, 0.03, -0.02);
            gunPivot.add(fpsBioticVial);

            // Reciprocating Side Bolt Handle (Kicks back on every shot!)
            const fpsBoltGroup = new THREE.Group();
            fpsBoltGroup.position.set(-0.052, 0.036, -0.01);
            gunPivot.add(fpsBoltGroup);
            const boltStem = new THREE.Mesh(new THREE.BoxGeometry(0.024, 0.02, 0.13), matMetalSilver);
            fpsBoltGroup.add(boltStem);
            const boltHandle = new THREE.Mesh(new THREE.CylinderGeometry(0.016, 0.016, 0.045, 10), matGunBlack);
            boltHandle.rotation.z = Math.PI / 2;
            boltHandle.position.set(-0.022, 0, 0.03);
            fpsBoltGroup.add(boltHandle);

            // Top Sniper Scope & Cyan Glass Reticle Ring
            const scopeMount = new THREE.Mesh(new THREE.BoxGeometry(0.038, 0.05, 0.14), matGunBlack);
            scopeMount.position.set(0, 0.11, 0.04);
            gunPivot.add(scopeMount);

            const scopeBody = new THREE.Mesh(new THREE.CylinderGeometry(0.042, 0.036, 0.24, 18), matGunBlack);
            scopeBody.rotation.x = Math.PI / 2;
            scopeBody.position.set(0, 0.148, 0.02);
            gunPivot.add(scopeBody);

            const scopeEyeRing = new THREE.Mesh(new THREE.RingGeometry(0.028, 0.042, 18), matCyanOptic);
            scopeEyeRing.position.set(0, 0.148, 0.141);
            gunPivot.add(scopeEyeRing);

            // Long Heavy Sniper Barrel & Silver Forked Muzzle Brake
            const fpsBarrel = new THREE.Mesh(new THREE.CylinderGeometry(0.020, 0.025, 0.95, 14), matGunBlack);
            fpsBarrel.rotation.x = Math.PI / 2;
            fpsBarrel.position.set(0, 0.06, -0.68);
            gunPivot.add(fpsBarrel);

            const fpsUnderTube = new THREE.Mesh(new THREE.CylinderGeometry(0.028, 0.028, 0.36, 14), matGunBlack);
            fpsUnderTube.rotation.x = Math.PI / 2;
            fpsUnderTube.position.set(0, -0.028, -0.38);
            gunPivot.add(fpsUnderTube);

            const fpsUnderCollar = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.07, 14), matMetalSilver);
            fpsUnderCollar.rotation.x = Math.PI / 2;
            fpsUnderCollar.position.set(0, -0.028, -0.22);
            gunPivot.add(fpsUnderCollar);

            const fpsMuzzleBrake = new THREE.Mesh(new THREE.BoxGeometry(0.046, 0.062, 0.18), matMetalSilver);
            fpsMuzzleBrake.position.set(0, 0.06, -1.18);
            gunPivot.add(fpsMuzzleBrake);

            const fpsMuzzleFlashMat = new THREE.MeshBasicMaterial({
                color: 0xfde047,
                transparent: true,
                opacity: 0.0,
                depthWrite: false
            });
            const fpsMuzzleFlash = new THREE.Mesh(new THREE.ConeGeometry(0.08, 0.28, 8), fpsMuzzleFlashMat);
            fpsMuzzleFlash.rotation.x = -Math.PI / 2;
            fpsMuzzleFlash.position.set(0, 0.06, -1.36);
            gunPivot.add(fpsMuzzleFlash);

            // Right Gloved Hand & Sleeve holding the grip
            const rArmGroup = new THREE.Group();
            rArmGroup.position.set(0.04, -0.11, 0.22);
            gunPivot.add(rArmGroup);
            const rSleeve = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.065, 0.32, 12), matSageOlive);
            rSleeve.rotation.x = 1.25;
            rSleeve.rotation.z = -0.25;
            rArmGroup.add(rSleeve);
            const rGlove = new THREE.Mesh(new THREE.BoxGeometry(0.075, 0.085, 0.11), matLeatherBlack);
            rGlove.position.set(-0.03, 0.05, -0.12);
            rArmGroup.add(rGlove);

            // 2. LEFT SIDE: MULTI-ACTION LEFT ARM (Forend Grip / Sleep Dart Pistol / Biotic Grenade Throw / Nano Boost)
            const leftActionPivot = new THREE.Group();
            leftActionPivot.position.set(-0.24, -0.26, -0.44);
            fpsRoot.add(leftActionPivot);

            const lSleeve = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.065, 0.34, 12), matSageOlive);
            lSleeve.rotation.x = 1.15;
            lSleeve.rotation.y = 0.35;
            lSleeve.position.set(-0.08, -0.10, 0.14);
            leftActionPivot.add(lSleeve);

            // Wrist Nano/Sleep Gauntlet
            const lWristArmor = new THREE.Mesh(new THREE.BoxGeometry(0.072, 0.072, 0.14), matMetalSilver);
            lWristArmor.position.set(-0.02, -0.02, 0.02);
            leftActionPivot.add(lWristArmor);

            const lGlove = new THREE.Mesh(new THREE.BoxGeometry(0.078, 0.075, 0.11), matLeatherBlack);
            lGlove.position.set(0.02, 0.01, -0.06);
            leftActionPivot.add(lGlove);

            // A. 1st-Person Sleep Dart Pistol Prop (Appears in left hand when pressing Shift!)
            const sleepPistolProp = new THREE.Group();
            sleepPistolProp.position.set(0.02, 0.06, -0.12);
            sleepPistolProp.visible = false;
            leftActionPivot.add(sleepPistolProp);

            const spBody = new THREE.Mesh(new THREE.BoxGeometry(0.058, 0.075, 0.24), matMetalSilver);
            sleepPistolProp.add(spBody);
            const spBlueShroud = new THREE.Mesh(new THREE.CylinderGeometry(0.028, 0.028, 0.26, 12), matRifleBlue);
            spBlueShroud.rotation.x = Math.PI / 2;
            spBlueShroud.position.set(0, 0.025, -0.04);
            sleepPistolProp.add(spBlueShroud);
            const spCyanCore = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.018, 0.12, 10), matCyanOptic);
            spCyanCore.rotation.x = Math.PI / 2;
            spCyanCore.position.set(0, 0.025, -0.14);
            sleepPistolProp.add(spCyanCore);

            // B. 1st-Person Biotic Grenade Prop (Appears in left hand when pressing E!)
            const nadeHandProp = new THREE.Group();
            nadeHandProp.position.set(0.04, 0.07, -0.10);
            nadeHandProp.visible = false;
            leftActionPivot.add(nadeHandProp);

            const nhGlass = new THREE.Mesh(new THREE.CylinderGeometry(0.052, 0.052, 0.14, 14), matBioticAmber);
            nadeHandProp.add(nhGlass);
            const nhPurpleSwirl = new THREE.Mesh(new THREE.CylinderGeometry(0.054, 0.054, 0.04, 14), matPurpleCore);
            nadeHandProp.add(nhPurpleSwirl);
            const nhCapTop = new THREE.Mesh(new THREE.CylinderGeometry(0.056, 0.056, 0.028, 14), matRifleBlue);
            nhCapTop.position.y = 0.07;
            nadeHandProp.add(nhCapTop);
            const nhCapBot = nhCapTop.clone();
            nhCapBot.position.y = -0.07;
            nadeHandProp.add(nhCapBot);

            return {
                root: fpsRoot,
                gunPivot,
                fpsMagazine,
                fpsBoltGroup,
                fpsBioticVial,
                fpsMuzzleFlash,
                fpsMuzzleFlashMat,
                leftActionPivot,
                sleepPistolProp,
                nadeHandProp
            };
        }
    </script>

    <script>
        /* ============================================================================
         * 3. SNOWY MOUNTAIN ENVIRONMENT & TRAINING RANGE BOTS
         * ============================================================================ */
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0xcbdcf7);
        scene.fog = new THREE.FogExp2(0xcbdcf7, 0.011);

        const canvas = document.getElementById('game-canvas');
        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        const camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 300);

        // Crisp Alpine Sunlight & Sky Illumination
        const hemiLight = new THREE.HemisphereLight(0xf0f9ff, 0x64748b, 0.85);
        scene.add(hemiLight);

        const dirLight = new THREE.DirectionalLight(0xfffbeb, 1.15);
        dirLight.position.set(35, 55, 25);
        dirLight.castShadow = true;
        dirLight.shadow.mapSize.width = 2048;
        dirLight.shadow.mapSize.height = 2048;
        dirLight.shadow.camera.near = 5;
        dirLight.shadow.camera.far = 140;
        const d = 40;
        dirLight.shadow.camera.left = -d;
        dirLight.shadow.camera.right = d;
        dirLight.shadow.camera.top = d;
        dirLight.shadow.camera.bottom = -d;
        scene.add(dirLight);

        // --- ENVIRONMENT BUILDER ---
        const worldObstacles = [];
        function buildSnowyRangeEnvironment() {
            // Main Snowy Tactical Terrace Floor
            const floorGeo = new THREE.BoxGeometry(70, 2, 70);
            const floorMat = new THREE.MeshStandardMaterial({ color: 0xe2e8f0, roughness: 0.85, metalness: 0.05 });
            const floor = new THREE.Mesh(floorGeo, floorMat);
            floor.position.y = -1;
            floor.receiveShadow = true;
            scene.add(floor);

            // Overwatch Orange/Slate Terrace Border Ledges (Like the stone/metal ledge in the photo!)
            const ledgeMat = new THREE.MeshStandardMaterial({ color: 0x9a5b3e, roughness: 0.7 });
            const snowCapMat = new THREE.MeshStandardMaterial({ color: 0xf8fafc, roughness: 0.9 });

            function createParapet(x, z, w, d, h = 1.1) {
                const group = new THREE.Group();
                const base = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), ledgeMat);
                base.position.y = h / 2;
                base.castShadow = true;
                base.receiveShadow = true;
                group.add(base);

                const cap = new THREE.Mesh(new THREE.BoxGeometry(w + 0.15, 0.18, d + 0.15), snowCapMat);
                cap.position.y = h + 0.05;
                cap.receiveShadow = true;
                group.add(cap);

                group.position.set(x, 0, z);
                scene.add(group);
                worldObstacles.push(base);
            }

            // Perimeter walls & sniper cover blocks
            createParapet(0, 12.6, 8, 1.2, 0.92);   // Iconic orange/stone sniper ledge right behind/under Ana (as in image_58b867.png!)
            createParapet(-12, 6, 5, 1.4, 1.5);
            createParapet(12, 6, 5, 1.4, 1.5);
            createParapet(-16, -12, 6, 2.0, 2.2);
            createParapet(16, -12, 6, 2.0, 2.2);

            // Distant Snowy Mountain Peaks (Recreating the majestic alpine background of image_58b867.png!)
            const mountainMat = new THREE.MeshStandardMaterial({
                color: 0xdbeafe,
                roughness: 0.85,
                metalness: 0.05,
                flatShading: true
            });
            const mountainConfigs = [
                // Peaks behind Ana (+Z) and in front (-Z) so any camera angle has the exact alpine backdrop!
                { x: -32, z: 58, r: 28, h: 46 },
                { x: 0, z: 68, r: 38, h: 58 },
                { x: 38, z: 55, r: 32, h: 48 },
                { x: -45, z: -55, r: 34, h: 52 },
                { x: -8, z: -62, r: 40, h: 60 },
                { x: 35, z: -52, r: 36, h: 54 },
                { x: -68, z: 5, r: 34, h: 48 },
                { x: 68, z: -5, r: 38, h: 52 }
            ];
            mountainConfigs.forEach(m => {
                const cone = new THREE.Mesh(new THREE.ConeGeometry(m.r, m.h, 12), mountainMat);
                cone.position.set(m.x, m.h / 2 - 8, m.z);
                cone.rotation.y = Math.random() * Math.PI;
                scene.add(cone);
            });

            // Sea of Clouds Layer around the mountain base
            const cloudMat = new THREE.MeshBasicMaterial({ color: 0xf1f5f9, transparent: true, opacity: 0.75 });
            for (let i = 0; i < 18; i++) {
                const angle = (i / 18) * Math.PI * 2;
                const dist = 46 + (i % 3) * 8;
                const cloud = new THREE.Mesh(new THREE.SphereGeometry(14, 10, 8), cloudMat);
                cloud.scale.set(1.8, 0.35, 1.2);
                cloud.position.set(Math.cos(angle) * dist, -2, Math.sin(angle) * dist);
                scene.add(cloud);
            }
        }
        buildSnowyRangeEnvironment();

        // Falling Snowflakes Particle System
        const snowCount = 450;
        const snowGeo = new THREE.BufferGeometry();
        const snowPos = new Float32Array(snowCount * 3);
        for (let i = 0; i < snowCount; i++) {
            snowPos[i * 3] = (Math.random() - 0.5) * 70;
            snowPos[i * 3 + 1] = Math.random() * 25;
            snowPos[i * 3 + 2] = (Math.random() - 0.5) * 70;
        }
        snowGeo.setAttribute('position', new THREE.BufferAttribute(snowPos, 3));
        const snowParticles = new THREE.Points(
            snowGeo,
            new THREE.PointsMaterial({ color: 0xffffff, size: 0.18, transparent: true, opacity: 0.8 })
        );
        scene.add(snowParticles);
    </script>

    <script>
        /* ============================================================================
         * 4. ALLIED & ENEMY TRAINING BOTS (Targetable for Heal, Damage, Sleep, Grenade, Nano)
         * ============================================================================ */
        const bots = [];
        const worldUiLayer = document.getElementById('world-ui-layer');

        function createBot(config) {
            const group = new THREE.Group();
            group.position.copy(config.startPos);
            scene.add(group);

            const isAlly = config.team === 'ally';
            const primaryColor = isAlly ? 0x2563eb : 0xdc2626;
            const glowColor = isAlly ? 0x38bdf8 : 0xf87171;

            const bodyMat = new THREE.MeshStandardMaterial({
                color: isAlly ? 0x1e293b : 0x27272a,
                roughness: 0.4,
                metalness: 0.6
            });
            const armorMat = new THREE.MeshStandardMaterial({
                color: primaryColor,
                roughness: 0.35,
                metalness: 0.4
            });
            const visorMat = new THREE.MeshBasicMaterial({ color: glowColor });

            // Pivot group for sleeping rotation (tips horizontal when slept!)
            const bodyPivot = new THREE.Group();
            group.add(bodyPivot);

            const scale = config.scale || 1.0;
            bodyPivot.scale.setScalar(scale);

            // Hover / Leg Base
            const base = new THREE.Mesh(new THREE.CylinderGeometry(0.32, 0.42, 0.7, 12), bodyMat);
            base.position.y = 0.35;
            bodyPivot.add(base);

            // Torso Chassis
            const chest = new THREE.Mesh(new THREE.BoxGeometry(0.82, 0.95, 0.52), armorMat);
            chest.position.y = 1.2;
            bodyPivot.add(chest);

            // Head & Glowing Visor Eye
            const head = new THREE.Mesh(new THREE.SphereGeometry(0.32, 16, 14), bodyMat);
            head.position.y = 1.95;
            bodyPivot.add(head);

            const visor = new THREE.Mesh(new THREE.BoxGeometry(0.46, 0.14, 0.22), visorMat);
            visor.position.set(0, 1.95, 0.22);
            bodyPivot.add(visor);

            // Arms / Weapon
            const rightArm = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.65, 0.22), bodyMat);
            rightArm.position.set(-0.56, 1.2, 0.15);
            rightArm.rotation.x = -0.6;
            bodyPivot.add(rightArm);

            const leftArm = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.65, 0.22), bodyMat);
            leftArm.position.set(0.56, 1.2, 0.15);
            bodyPivot.add(leftArm);

            // Nano Boost Electric Aura Shell (Hidden until Nano Boosted!)
            const nanoAuraMat = new THREE.MeshBasicMaterial({
                color: 0x3b82f6,
                wireframe: true,
                transparent: true,
                opacity: 0.0
            });
            const nanoAura = new THREE.Mesh(new THREE.CylinderGeometry(0.75, 0.75, 2.3, 10), nanoAuraMat);
            nanoAura.position.y = 1.15;
            bodyPivot.add(nanoAura);

            bodyPivot.traverse(o => {
                if (o.isMesh) {
                    o.castShadow = true;
                    o.receiveShadow = true;
                }
            });

            // Create DOM Floating HP Bar & Status Label
            const labelEl = document.createElement('div');
            labelEl.className = 'world-label flex flex-col items-center';
            labelEl.innerHTML = `
                <div class="status-badges flex items-center gap-1 mb-0.5 text-xs font-black"></div>
                <div class="text-[11px] font-bold px-2 py-0.5 rounded bg-slate-950/80 ${isAlly ? 'text-cyan-300' : 'text-red-400'} border ${isAlly ? 'border-cyan-500/40' : 'border-red-500/40'} whitespace-nowrap">
                    ${config.name}
                </div>
                <div class="hp-frame w-28 h-3.5 bg-slate-950/90 rounded p-0.5 mt-0.5 border border-white/30 overflow-hidden shadow-md">
                    <div class="hp-fill h-full ${isAlly ? 'bg-cyan-400' : 'bg-red-500'} transition-all duration-100" style="width: 100%"></div>
                </div>
            `;
            worldUiLayer.appendChild(labelEl);

            const botObj = {
                id: config.id,
                name: config.name,
                team: config.team,
                maxHp: config.maxHp,
                hp: config.initialHp,
                isAerial: Boolean(config.isAerial),
                flyHeight: config.flyHeight || 0,
                currentFlyY: config.flyHeight || 0,
                group,
                bodyPivot,
                armorMat,
                nanoAura,
                nanoAuraMat,
                baseScale: scale,
                startPos: config.startPos.clone(),
                patrolRange: config.patrolRange || 0,
                patrolSpeed: config.patrolSpeed || 1.2,
                patrolPhase: Math.random() * Math.PI * 2,
                sleepTimer: 0,
                antiHealTimer: 0,
                healBoostTimer: 0,
                nanoTimer: 0,
                fireCooldown: 1.5 + Math.random() * 1.5,
                labelEl,
                hpFrameEl: labelEl.querySelector('.hp-frame'),
                hpFillEl: labelEl.querySelector('.hp-fill'),
                badgesEl: labelEl.querySelector('.status-badges')
            };

            bots.push(botObj);
            return botObj;
        }

        // Spawn Allied & Enemy Bots in the Snowy Training Range
        createBot({
            id: 'ally-1',
            name: '아군 돌격 봇 [라인하르트형]',
            team: 'ally',
            maxHp: 500,
            initialHp: 260,
            scale: 1.25,
            startPos: new THREE.Vector3(-5.5, 0, -4.5),
            patrolRange: 3.5,
            patrolSpeed: 0.9
        });
        createBot({
            id: 'ally-2',
            name: '아군 공격 봇 [솔저: 76형]',
            team: 'ally',
            maxHp: 250,
            initialHp: 135,
            scale: 1.0,
            startPos: new THREE.Vector3(5.5, 0, -5.5),
            patrolRange: 4.5,
            patrolSpeed: 1.4
        });
        createBot({
            id: 'enemy-1',
            name: '적 강습 봇 ALPHA',
            team: 'enemy',
            maxHp: 250,
            initialHp: 250,
            scale: 1.0,
            startPos: new THREE.Vector3(-9, 0, -15),
            patrolRange: 5,
            patrolSpeed: 1.6
        });
        createBot({
            id: 'enemy-2',
            name: '적 중장갑 봇 OMEGA',
            team: 'enemy',
            maxHp: 450,
            initialHp: 450,
            scale: 1.22,
            startPos: new THREE.Vector3(0, 0, -18),
            patrolRange: 6,
            patrolSpeed: 1.1
        });
        createBot({
            id: 'enemy-3',
            name: '적 저격 봇 SIGMA',
            team: 'enemy',
            maxHp: 250,
            initialHp: 250,
            scale: 1.0,
            startPos: new THREE.Vector3(10, 0, -17),
            patrolRange: 6,
            patrolSpeed: 1.9
        });
        createBot({
            id: 'enemy-aerial',
            name: '적 공중 기동 봇 [파라형]',
            team: 'enemy',
            maxHp: 225,
            initialHp: 225,
            scale: 0.95,
            isAerial: true,
            flyHeight: 4.8,
            startPos: new THREE.Vector3(2, 4.8, -14),
            patrolRange: 7.5,
            patrolSpeed: 1.45
        });
    </script>

    <script>
        /* ============================================================================
         * 5. PLAYER ANA STATE, CAMERA SYSTEM & HERO POSE SHOWCASE
         * ============================================================================ */
        const anaModel = createAnaCharacterModel();
        scene.add(anaModel.root);

        const fpsViewModel = createFirstPersonViewModel();
        camera.add(fpsViewModel.root);
        scene.add(camera);

        const combatStats = {
            heal: 0,
            dmg: 0,
            sleep: 0,
            elim: 0
        };

        function updateCombatStatsHud() {
            document.getElementById('stat-heal').textContent = Math.round(combatStats.heal).toLocaleString();
            document.getElementById('stat-dmg').textContent = Math.round(combatStats.dmg).toLocaleString();
            document.getElementById('stat-sleep').textContent = combatStats.sleep;
            document.getElementById('stat-elim').textContent = combatStats.elim;
        }

        function spawnFloatingText(worldPos, text, colorHex = '#fde047', scaleClass = 'text-base') {
            const p = worldPos.clone();
            p.project(camera);
            if (p.z >= 1.0) return;
            const sx = (p.x * 0.5 + 0.5) * window.innerWidth + (Math.random() - 0.5) * 28;
            const sy = (-p.y * 0.5 + 0.5) * window.innerHeight;

            const el = document.createElement('div');
            el.className = `floating-combat-text ${scaleClass}`;
            el.style.left = `${sx}px`;
            el.style.top = `${sy}px`;
            el.style.color = colorHex;
            el.textContent = text;
            worldUiLayer.appendChild(el);
            setTimeout(() => el.remove(), 1050);
        }

        const player = {
            pos: new THREE.Vector3(0, 0, 11.4),
            vel: new THREE.Vector3(),
            yaw: Math.PI, // Facing -Z (towards the training range & mountains)
            pitch: 0,
            hp: 250,
            maxHp: 250,
            healBoostTimer: 0,
            ammo: 10,
            maxAmmo: 10,
            isReloading: false,
            reloadTimer: 0,
            isScoped: false,
            // Start in 'pose' (Iconic Reference Photo 3/4 Angle) so user immediately sees the exact Ana from image_58b867.png AND can shoot/use skills right away!
            viewMode: 'pose', // 'tps' | 'fps' | 'pose'
            fireCooldown: 0,
            recoilOffset: 0,
            // Dedicated Action Animation Timers (Drives 3rd-person & 1st-person joint animations)
            shootAnimTimer: 0,   // Bolt cycle + recoil + muzzle flash
            sleepAnimTimer: 0,   // Left arm raises Sleep Dart Pistol & fires
            nadeAnimTimer: 0,    // Left arm winds up & throws Biotic Grenade
            nanoAnimTimer: 0,    // Left arm fires Nano Boost dart
            walkPhase: 0,        // Continuous phase for multi-joint walk cycle
            walkWeight: 0,       // Smoothly blended 0..1 locomotion weight
            swayX: 0,            // 1st-person weapon mouse lag X
            swayY: 0,            // 1st-person weapon mouse lag Y
            cdShift: 0,          // Sleep Dart cooldown (8s)
            cdE: 0,              // Biotic Grenade cooldown (6s)
            ultCharge: 100,      // Start at 100% so user can try Nano Boost right away!
            poseOrbitYaw: -0.62,
            poseOrbitPitch: 0.04,
            poseZoomDist: 1.85
        };

        anaModel.root.position.copy(player.pos);

        // Build Player HP Pips in HUD
        const pipsContainer = document.getElementById('player-hp-pips');
        const hpPipEls = [];
        for (let i = 0; i < 10; i++) {
            const pip = document.createElement('div');
            pip.className = 'hp-pip bg-white shadow-[0_0_6px_rgba(255,255,255,0.6)]';
            pipsContainer.appendChild(pip);
            hpPipEls.push(pip);
        }

        function updatePlayerHud() {
            document.getElementById('player-hp-num').textContent = Math.ceil(player.hp);
            const activePips = Math.ceil((player.hp / player.maxHp) * 10);
            hpPipEls.forEach((pip, idx) => {
                if (idx < activePips) {
                    pip.className = player.healBoostTimer > 0
                        ? 'hp-pip bg-amber-300 shadow-[0_0_8px_#fbbf24]'
                        : 'hp-pip bg-white shadow-[0_0_6px_rgba(255,255,255,0.6)]';
                } else {
                    pip.className = 'hp-pip bg-slate-700/60';
                }
            });

            // Self heal-boost border indicator
            const selfBadge = document.getElementById('self-buff-badge');
            if (player.healBoostTimer > 0) {
                selfBadge.classList.remove('hidden');
            } else {
                selfBadge.classList.add('hidden');
            }

            // Ammo
            document.getElementById('ammo-current').textContent = player.isReloading ? '장전중' : player.ammo;

            // Cooldowns
            const shiftBox = document.getElementById('btn-skill-shift');
            const shiftText = document.getElementById('cd-shift');
            if (player.cdShift > 0) {
                shiftBox.classList.remove('ready');
                shiftBox.classList.add('on-cooldown');
                shiftText.textContent = player.cdShift.toFixed(1) + 's';
                shiftText.className = 'text-sm font-black text-red-400 mt-0.5';
            } else {
                shiftBox.classList.add('ready');
                shiftBox.classList.remove('on-cooldown');
                shiftText.textContent = '수면총';
                shiftText.className = 'text-[11px] font-bold text-white mt-0.5';
            }

            const eBox = document.getElementById('btn-skill-e');
            const eText = document.getElementById('cd-e');
            if (player.cdE > 0) {
                eBox.classList.remove('ready');
                eBox.classList.add('on-cooldown');
                eText.textContent = player.cdE.toFixed(1) + 's';
                eText.className = 'text-sm font-black text-red-400 mt-0.5';
            } else {
                eBox.classList.add('ready');
                eBox.classList.remove('on-cooldown');
                eText.textContent = '생체탄';
                eText.className = 'text-[11px] font-bold text-white mt-0.5';
            }

            // Ultimate Ring
            const ultPct = Math.floor(player.ultCharge);
            document.getElementById('ult-percent-text').textContent = ultPct >= 100 ? 'READY' : `${ultPct}%`;
            const dashOffset = 264 - (264 * Math.min(100, ultPct)) / 100;
            const ultRing = document.getElementById('ult-ring');
            ultRing.style.strokeDashoffset = dashOffset;
            ultRing.style.stroke = ultPct >= 100 ? '#fbbf24' : '#38bdf8';
        }

        // Combat Callout Toast Feed
        function showCombatCallout(title, subtitle, colorClass = 'border-cyan-400 text-cyan-300') {
            const feed = document.getElementById('combat-feed');
            const toast = document.createElement('div');
            toast.className = `event-toast bg-slate-950/90 border-l-4 ${colorClass} px-4 py-1.5 rounded-r-lg shadow-lg backdrop-blur-md text-center`;
            toast.innerHTML = `
                <div class="text-xs sm:text-sm font-black tracking-wide">${title}</div>
                ${subtitle ? `<div class="text-[11px] text-slate-300">${subtitle}</div>` : ''}
            `;
            feed.appendChild(toast);
            setTimeout(() => toast.remove(), 2400);
        }

        // Hitmarker Flash
        let hitMarkerTimeout = null;
        function flashHitMarker(isHeal = false) {
            const hm = document.getElementById('hit-marker');
            const color = isHeal ? '#fde047' : '#ef4444';
            ['hm-1', 'hm-2', 'hm-3', 'hm-4'].forEach(id => {
                document.getElementById(id).setAttribute('stroke', color);
            });
            hm.style.opacity = '1';
            clearTimeout(hitMarkerTimeout);
            hitMarkerTimeout = setTimeout(() => {
                hm.style.opacity = '0';
            }, 180);
        }
    </script>

    <script>
        /* ============================================================================
         * 6. ANA COMBAT & ABILITIES ENGINE (Rifle, Scope, Sleep Dart, Biotic Grenade, Nano)
         * ============================================================================ */
        const projectiles = [];
        const transientEffects = [];

        // Helper: Spawn floating 3D particle burst (heal yellow, damage purple, sleep cyan, nano blue)
        function spawnParticleBurst(pos, colorHex, count = 14, speed = 4, radius = 0.12) {
            const group = new THREE.Group();
            group.position.copy(pos);
            scene.add(group);

            const mat = new THREE.MeshBasicMaterial({ color: colorHex, transparent: true, opacity: 0.95 });
            const geo = new THREE.SphereGeometry(radius, 8, 8);
            const parts = [];

            for (let i = 0; i < count; i++) {
                const m = new THREE.Mesh(geo, mat);
                const dir = new THREE.Vector3(
                    (Math.random() - 0.5) * 2,
                    Math.random() * 1.6,
                    (Math.random() - 0.5) * 2
                ).normalize().multiplyScalar(speed * (0.4 + Math.random() * 0.8));
                group.add(m);
                parts.push({ mesh: m, vel: dir });
            }

            transientEffects.push({
                type: 'burst',
                group,
                mat,
                parts,
                life: 0.55,
                maxLife: 0.55
            });
        }

        // Helper: Spawn Scoped Hitscan Beam Trail (Yellow/Cyan or Purple)
        function spawnBeamTrail(startPos, endPos, colorHex) {
            const curve = new THREE.LineCurve3(startPos, endPos);
            const geo = new THREE.TubeGeometry(curve, 2, 0.028, 6, false);
            const mat = new THREE.MeshBasicMaterial({ color: colorHex, transparent: true, opacity: 0.9 });
            const mesh = new THREE.Mesh(geo, mat);
            scene.add(mesh);

            transientEffects.push({
                type: 'beam',
                mesh,
                mat,
                life: 0.25,
                maxLife: 0.25
            });
        }

        // Calculate Camera Aim Ray in World Space
        const raycaster = new THREE.Raycaster();
        function getAimRay() {
            if (player.viewMode === 'pose') {
                // In Pose/Showcase mode, fire straight along the Biotic Rifle's barrel direction towards the bots!
                const muzzlePos = new THREE.Vector3();
                anaModel.muzzlePoint.getWorldPosition(muzzlePos);
                const forwardDir = new THREE.Vector3(
                    -Math.sin(player.yaw) * Math.cos(player.pitch),
                    Math.sin(player.pitch),
                    -Math.cos(player.yaw) * Math.cos(player.pitch)
                ).normalize();
                return new THREE.Ray(muzzlePos, forwardDir);
            }
            raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
            return raycaster.ray;
        }

        // Apply Biotic Rifle Hit Effect (Heal Ally or Damage Enemy)
        function applyBioticRifleHit(bot, impactPoint) {
            if (bot.team === 'ally') {
                if (bot.antiHealTimer > 0) {
                    showCombatCallout('치유 차단 상태!', '아군이 치유 차단 상태입니다', 'border-purple-500 text-purple-300');
                    return;
                }
                const mult = bot.healBoostTimer > 0 ? 1.5 : 1.0;
                const healAmount = Math.round(75 * mult);
                bot.hp = Math.min(bot.maxHp, bot.hp + healAmount);
                combatStats.heal += healAmount;
                updateCombatStatsHud();
                player.ultCharge = Math.min(100, player.ultCharge + 8);
                sfx.playBioticTicks(true);
                flashHitMarker(true);
                spawnParticleBurst(impactPoint, 0xfacc15, 14, 3.5, 0.11);
                spawnFloatingText(impactPoint, `+${healAmount} 치유`, '#fde047', mult > 1 ? 'text-lg' : 'text-base');
            } else {
                // Wakes enemy up if sleeping!
                if (bot.sleepTimer > 0) {
                    bot.sleepTimer = 0;
                    showCombatCallout('수면 해제!', `${bot.name}이(가) 공격받아 깨어났습니다!`, 'border-amber-400 text-amber-300');
                }
                const dmgAmount = 75;
                bot.hp = Math.max(0, bot.hp - dmgAmount);
                combatStats.dmg += dmgAmount;
                updateCombatStatsHud();
                player.ultCharge = Math.min(100, player.ultCharge + 9);
                sfx.playBioticTicks(false);
                flashHitMarker(false);
                spawnParticleBurst(impactPoint, 0xa855f7, 14, 3.5, 0.11);
                spawnFloatingText(impactPoint, `-${dmgAmount}`, '#c084fc', 'text-base');

                if (bot.hp <= 0) {
                    combatStats.elim++;
                    updateCombatStatsHud();
                    showCombatCallout(`🎯 처치 완료! (${bot.name})`, '잠시 후 봇이 재생성됩니다', 'border-red-500 text-red-300');
                    setTimeout(() => {
                        bot.hp = bot.maxHp;
                        bot.sleepTimer = 0;
                        bot.antiHealTimer = 0;
                    }, 2200);
                }
            }
        }

        // Helper: Eject spent Biotic Syringe Casing from the rifle's side port
        function ejectBioticCasing() {
            const casingGeo = new THREE.CylinderGeometry(0.016, 0.016, 0.085, 8);
            casingGeo.rotateZ(Math.PI / 2);
            const casingMat = new THREE.MeshStandardMaterial({
                color: 0xfbbf24,
                metalness: 0.7,
                roughness: 0.25,
                transparent: true,
                opacity: 1.0
            });
            const casingMesh = new THREE.Mesh(casingGeo, casingMat);

            const ejectOrigin = new THREE.Vector3();
            if (player.viewMode === 'fps' && !player.isScoped) {
                fpsViewModel.fpsBoltGroup.getWorldPosition(ejectOrigin);
            } else {
                anaModel.boltCarrierGroup.getWorldPosition(ejectOrigin);
            }
            casingMesh.position.copy(ejectOrigin);
            scene.add(casingMesh);

            const rightDir = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));
            const vel = rightDir.multiplyScalar(-2.4 - Math.random() * 1.2);
            vel.y = 2.6 + Math.random() * 1.1;

            transientEffects.push({
                type: 'casing',
                mesh: casingMesh,
                mat: casingMat,
                vel,
                life: 1.1,
                maxLife: 1.1
            });
        }

        // 1. PRIMARY FIRE: Biotic Rifle (Unscoped Projectile OR Scoped Hitscan)
        function fireBioticRifle() {
            if (player.isReloading || player.fireCooldown > 0) return;
            if (player.ammo <= 0) {
                triggerReload();
                return;
            }

            player.ammo--;
            player.fireCooldown = 0.72;
            player.recoilOffset = 0.22;
            player.shootAnimTimer = 0.68; // Triggers recoil -> bolt pull back -> casing eject -> bolt forward!
            sfx.playRifleShot(player.isScoped);

            // Eject glowing brass/amber biotic syringe casing mid-cycle
            setTimeout(() => ejectBioticCasing(), 210);

            const muzzleWorld = new THREE.Vector3();
            if (player.viewMode === 'fps' && !player.isScoped) {
                fpsViewModel.fpsMuzzleFlash.getWorldPosition(muzzleWorld);
            } else {
                anaModel.muzzlePoint.getWorldPosition(muzzleWorld);
            }

            const aimRay = getAimRay();
            const targetPoint = aimRay.origin.clone().add(aimRay.direction.clone().multiplyScalar(80));

            // Check direct ray intersection against all bots first
            let hitBot = null;
            let bestDist = Infinity;
            let hitPos = targetPoint.clone();

            bots.forEach(bot => {
                const botCenter = bot.group.position.clone().add(new THREE.Vector3(0, 1.15 * bot.baseScale, 0));
                // Generous hitbox radius for allies (just like Overwatch Ana's friendly aim assist!)
                const hitRadius = bot.team === 'ally' ? 1.15 : 0.85;
                const distToRay = aimRay.distanceSqToPoint(botCenter);
                if (distToRay <= hitRadius * hitRadius) {
                    const d = aimRay.origin.distanceTo(botCenter);
                    if (d < bestDist) {
                        bestDist = d;
                        hitBot = bot;
                        hitPos = botCenter;
                    }
                }
            });

            if (player.isScoped) {
                // HITSCAN MODE: Instant trace & impact
                const beamColor = hitBot ? (hitBot.team === 'ally' ? 0xfacc15 : 0xa855f7) : 0x38bdf8;
                const startTrace = muzzleWorld.clone();
                spawnBeamTrail(startTrace, hitPos, beamColor);
                if (hitBot) {
                    applyBioticRifleHit(hitBot, hitPos);
                } else {
                    spawnParticleBurst(hitPos, 0x38bdf8, 8, 2.5, 0.08);
                }
            } else {
                // UNSCOPED MODE: Fast glowing Biotic Syringe Dart projectile
                const dartGeo = new THREE.CylinderGeometry(0.035, 0.035, 0.55, 8);
                dartGeo.rotateX(Math.PI / 2);
                const dartMat = new THREE.MeshBasicMaterial({ color: 0xfbbf24 });
                const dartMesh = new THREE.Mesh(dartGeo, dartMat);
                dartMesh.position.copy(muzzleWorld);
                const dir = targetPoint.clone().sub(muzzleWorld).normalize();
                dartMesh.lookAt(muzzleWorld.clone().add(dir));
                scene.add(dartMesh);

                projectiles.push({
                    type: 'biotic-dart',
                    mesh: dartMesh,
                    vel: dir.multiplyScalar(68),
                    life: 2.0
                });
            }

            if (player.ammo === 0) {
                setTimeout(() => triggerReload(), 280);
            }
            updatePlayerHud();
        }

        // 2. RELOAD (R)
        function triggerReload() {
            if (player.isReloading || player.ammo === player.maxAmmo) return;
            player.isReloading = true;
            player.reloadTimer = 1.35;
            if (player.isScoped) toggleScope(false);
            sfx.playReload();
            showCombatCallout('🔄 재장전 중...', '생체 실린더 탄창 교체 모션', 'border-cyan-400 text-cyan-200');
            updatePlayerHud();
        }

        // 3. SCOPE TOGGLE (Right Click / Z)
        function toggleScope(forceState = null) {
            if (player.isReloading && forceState !== false) return;
            if (player.viewMode === 'pose' && forceState !== false) {
                setViewMode('tps');
            }
            player.isScoped = forceState !== null ? forceState : !player.isScoped;
            const scopeEl = document.getElementById('scope-overlay');
            const normalCh = document.getElementById('normal-crosshair');

            if (player.isScoped) {
                scopeEl.style.opacity = '1';
                normalCh.style.opacity = '0';
                camera.fov = 26; // 4.5x Sniper Zoom
                anaModel.root.visible = false;
                fpsViewModel.root.visible = false;
            } else {
                scopeEl.style.opacity = '0';
                normalCh.style.opacity = '1';
                camera.fov = 65;
                anaModel.root.visible = (player.viewMode !== 'fps');
                fpsViewModel.root.visible = (player.viewMode === 'fps');
            }
            camera.updateProjectionMatrix();
        }

        // 4. SLEEP DART (L-Shift) - "수면총!" (With Left-Hand Pistol Draw & Recoil Animation!)
        function fireSleepDart() {
            if (player.cdShift > 0) return;

            player.cdShift = 8.0;
            player.sleepAnimTimer = 0.78; // Left arm raises Sleep Dart Pistol & kicks back!
            if (player.isScoped) toggleScope(false);
            sfx.playSleepDart();
            showCombatCallout('💤 수면총 발사!', '"코 자렴." (왼손 수면총 발사 모션)', 'border-cyan-400 text-cyan-300');

            // Slight wind-up delay (120ms) matching Overwatch's iconic Sleep Dart cast feel
            setTimeout(() => {
                const startPos = new THREE.Vector3();
                if (player.viewMode === 'fps') {
                    fpsViewModel.sleepPistolProp.getWorldPosition(startPos);
                } else {
                    anaModel.sleepGauntlet.getWorldPosition(startPos);
                }

                // Cyan pneumatic flash at gauntlet/pistol tip
                spawnParticleBurst(startPos, 0x22d3ee, 10, 2.8, 0.07);

                const aimRay = getAimRay();
                const targetPoint = aimRay.origin.clone().add(aimRay.direction.clone().multiplyScalar(65));
                const dir = targetPoint.sub(startPos).normalize();

                const dartGeo = new THREE.CylinderGeometry(0.055, 0.055, 0.75, 10);
                dartGeo.rotateX(Math.PI / 2);
                const dartMat = new THREE.MeshBasicMaterial({ color: 0x22d3ee });
                const dartMesh = new THREE.Mesh(dartGeo, dartMat);
                dartMesh.position.copy(startPos);
                dartMesh.lookAt(startPos.clone().add(dir));
                scene.add(dartMesh);

                projectiles.push({
                    type: 'sleep-dart',
                    mesh: dartMesh,
                    vel: dir.multiplyScalar(50),
                    life: 2.2
                });
            }, 110);

            updatePlayerHud();
        }

        // 5. BIOTIC GRENADE (E) - "생체 수류탄 투척!" (With Left-Arm Windup & Overhand/Underhand Throw Motion!)
        function throwBioticGrenade() {
            if (player.cdE > 0) return;

            player.cdE = 6.0;
            player.nadeAnimTimer = 0.65; // Drives left arm wind-up and forward toss!
            if (player.isScoped) toggleScope(false);
            showCombatCallout('🧪 생체 수류탄 투척!', '아군 치유 강화 (+50%) / 적 치유 차단', 'border-amber-400 text-amber-300');

            // Release the grenade at the peak of the arm swing (140ms)
            setTimeout(() => {
                const startPos = new THREE.Vector3();
                if (player.viewMode === 'fps') {
                    fpsViewModel.nadeHandProp.getWorldPosition(startPos);
                } else {
                    anaModel.lHand.getWorldPosition(startPos);
                }

                const aimRay = getAimRay();
                const throwVel = aimRay.direction.clone().multiplyScalar(25);
                throwVel.y += 4.8; // Arcing throw

                const nadeGroup = new THREE.Group();
                const jar = new THREE.Mesh(
                    new THREE.CylinderGeometry(0.14, 0.14, 0.34, 12),
                    new THREE.MeshBasicMaterial({ color: 0xfbbf24 })
                );
                const ring = new THREE.Mesh(
                    new THREE.TorusGeometry(0.15, 0.03, 8, 12),
                    new THREE.MeshBasicMaterial({ color: 0x3b82f6 })
                );
                nadeGroup.add(jar);
                nadeGroup.add(ring);
                nadeGroup.position.copy(startPos);
                scene.add(nadeGroup);

                projectiles.push({
                    type: 'biotic-grenade',
                    mesh: nadeGroup,
                    vel: throwVel,
                    life: 4.0
                });
            }, 140);

            updatePlayerHud();
        }

        function detonateBioticGrenade(pos) {
            sfx.playGrenadeSplash();
            const splashRadius = 5.5;

            // Expanding ring visual on ground
            const ringGeo = new THREE.RingGeometry(0.2, splashRadius, 32);
            ringGeo.rotateX(-Math.PI / 2);
            const ringMat = new THREE.MeshBasicMaterial({
                color: 0xfacc15,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.75
            });
            const ringMesh = new THREE.Mesh(ringGeo, ringMat);
            ringMesh.position.set(pos.x, 0.08, pos.z);
            scene.add(ringMesh);

            transientEffects.push({
                type: 'beam',
                mesh: ringMesh,
                mat: ringMat,
                life: 0.55,
                maxLife: 0.55
            });

            spawnParticleBurst(pos, 0xfacc15, 22, 6, 0.16);
            spawnParticleBurst(pos, 0xa855f7, 18, 5, 0.15);

            // Check self-splash for Ana
            if (player.pos.distanceTo(pos) <= splashRadius) {
                player.hp = Math.min(player.maxHp, player.hp + 90);
                player.healBoostTimer = 4.5;
            }

            // Affect Bots in Splash Radius
            bots.forEach(bot => {
                if (bot.group.position.distanceTo(pos) <= splashRadius) {
                    const botTop = bot.group.position.clone().add(new THREE.Vector3(0, 1.8, 0));
                    if (bot.team === 'ally') {
                        bot.antiHealTimer = 0;
                        bot.healBoostTimer = 4.5;
                        bot.hp = Math.min(bot.maxHp, bot.hp + 90);
                        combatStats.heal += 90;
                        player.ultCharge = Math.min(100, player.ultCharge + 10);
                        flashHitMarker(true);
                        spawnFloatingText(botTop, '+90 ➕치유강화!', '#fde047', 'text-lg');
                    } else {
                        if (bot.sleepTimer > 0) bot.sleepTimer = 0;
                        bot.antiHealTimer = 4.5;
                        bot.hp = Math.max(10, bot.hp - 60);
                        combatStats.dmg += 60;
                        player.ultCharge = Math.min(100, player.ultCharge + 10);
                        flashHitMarker(false);
                        spawnFloatingText(botTop, '-60 🚫치유차단!', '#c084fc', 'text-lg');
                    }
                }
            });
            updateCombatStatsHud();
            updatePlayerHud();
        }

        // 6. NANO BOOST ULTIMATE (Q) - "나노 강화제를 투여했다!"
        function activateNanoBoost() {
            if (player.ultCharge < 100) {
                showCombatCallout('궁극기 충전 중!', `현재 궁극기 충전량: ${Math.floor(player.ultCharge)}%`, 'border-slate-400 text-slate-200');
                return;
            }

            // Find best allied bot near crosshair (or closest ally)
            const aimRay = getAimRay();
            let targetAlly = null;
            let bestScore = Infinity;

            bots.filter(b => b.team === 'ally').forEach(ally => {
                const center = ally.group.position.clone().add(new THREE.Vector3(0, 1.2, 0));
                const d = aimRay.distanceToPoint(center);
                if (d < bestScore) {
                    bestScore = d;
                    targetAlly = ally;
                }
            });

            if (!targetAlly) return;

            player.ultCharge = 0;
            player.nanoAnimTimer = 0.72; // Left wrist Nano Launcher animation!
            sfx.playNanoBoost();

            // Electric blue beam from Ana to target Ally
            const startPos = player.pos.clone().add(new THREE.Vector3(0, 1.5, 0));
            const endPos = targetAlly.group.position.clone().add(new THREE.Vector3(0, 1.3, 0));
            spawnBeamTrail(startPos, endPos, 0x3b82f6);
            spawnParticleBurst(endPos, 0x60a5fa, 30, 7, 0.18);
            spawnFloatingText(endPos, '⚡ 나노 강화제 투여! (+250)', '#60a5fa', 'text-xl');

            // Empower Ally for 8 seconds!
            targetAlly.nanoTimer = 8.0;
            targetAlly.hp = Math.min(targetAlly.maxHp, targetAlly.hp + 250);
            combatStats.heal += 250;
            updateCombatStatsHud();

            // Screen electric glow effect
            const screenFx = document.getElementById('screen-fx');
            screenFx.classList.add('nano-glow');
            setTimeout(() => screenFx.classList.remove('nano-glow'), 3500);

            showCombatCallout(
                '⚡ "나노 강화제를 투여했다!"',
                `${targetAlly.name} : "힘이 넘쳐흐른다!!" (공격력 +50% / 피해감소 50%)`,
                'border-blue-400 text-blue-300'
            );
            updatePlayerHud();
        }
    </script>

    <script>
        /* ============================================================================
         * 7. INPUT HANDLING (Keyboard, Mouse PointerLock + Drag Fallback, UI Buttons)
         * ============================================================================ */
        const keys = {};
        let isDraggingLook = false;

        window.addEventListener('keydown', (e) => {
            keys[e.code] = true;
            if (e.code === 'KeyR') triggerReload();
            if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') {
                e.preventDefault();
                fireSleepDart();
            }
            if (e.code === 'KeyE') throwBioticGrenade();
            if (e.code === 'KeyQ') activateNanoBoost();
            if (e.code === 'KeyZ') toggleScope();
            if (e.code === 'KeyV') {
                setViewMode(player.viewMode === 'tps' ? 'fps' : 'tps');
            }
            if (e.code === 'KeyC') {
                setViewMode(player.viewMode === 'pose' ? 'tps' : 'pose');
            }
            if (e.code === 'Space' && Math.abs(player.pos.y) < 0.05 && player.viewMode !== 'pose') {
                player.vel.y = 6.8;
            }
        });

        window.addEventListener('keyup', (e) => {
            keys[e.code] = false;
        });

        // PointerLock & Mouse Aiming
        let pointerDownPos = { x: 0, y: 0 };
        canvas.addEventListener('mousedown', (e) => {
            sfx.init();
            pointerDownPos = { x: e.clientX, y: e.clientY };
            if (player.viewMode === 'pose') {
                isDraggingLook = true;
                return;
            }
            if (document.pointerLockElement !== canvas) {
                if (canvas.requestPointerLock) {
                    canvas.requestPointerLock();
                }
                isDraggingLook = true;
            } else {
                if (e.button === 0) fireBioticRifle();
                if (e.button === 2) toggleScope();
            }
        });

        window.addEventListener('mouseup', (e) => {
            // In Pose view, a quick click (without dragging) fires the Biotic Rifle so you can see Ana shoot in close-up!
            if (player.viewMode === 'pose' && e.button === 0) {
                const moveDist = Math.hypot(e.clientX - pointerDownPos.x, e.clientY - pointerDownPos.y);
                if (moveDist < 6 && e.target === canvas) {
                    fireBioticRifle();
                }
            }
            isDraggingLook = false;
        });

        canvas.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            if (document.pointerLockElement !== canvas) {
                toggleScope();
            }
        });

        // Mouse Wheel Zoom in Pose Mode
        canvas.addEventListener('wheel', (e) => {
            if (player.viewMode === 'pose') {
                e.preventDefault();
                player.poseZoomDist = Math.max(1.05, Math.min(3.5, player.poseZoomDist + e.deltaY * 0.0015));
            }
        }, { passive: false });

        window.addEventListener('mousemove', (e) => {
            const sensitivity = player.isScoped ? 0.0011 : 0.0024;
            if (player.viewMode === 'pose' && isDraggingLook) {
                player.poseOrbitYaw -= e.movementX * 0.007;
                player.poseOrbitPitch = Math.max(-0.4, Math.min(0.75, player.poseOrbitPitch + e.movementY * 0.006));
                return;
            }
            if (document.pointerLockElement === canvas || isDraggingLook) {
                player.yaw -= e.movementX * sensitivity;
                player.pitch = Math.max(-1.1, Math.min(1.1, player.pitch - e.movementY * sensitivity));
                // Accumulate weapon sway for 1st-person viewmodel realism
                player.swayX = THREE.MathUtils.clamp(player.swayX - e.movementX * 0.0006, -0.045, 0.045);
                player.swayY = THREE.MathUtils.clamp(player.swayY + e.movementY * 0.0006, -0.045, 0.045);
            }
        });

        // View Mode Switcher ('tps' | 'fps' | 'pose')
        function setViewMode(mode) {
            if (player.isScoped) toggleScope(false);
            player.viewMode = mode;

            const btnTps = document.getElementById('btn-cam-tps');
            const btnFps = document.getElementById('btn-cam-fps');
            const btnPose = document.getElementById('btn-cam-pose');
            const poseBanner = document.getElementById('pose-showcase-banner');
            const chLayer = document.getElementById('crosshair-layer');

            btnTps.className = mode === 'tps'
                ? 'px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white border border-blue-400 shadow'
                : 'px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800/90 text-slate-200 border border-slate-600';
            btnFps.className = mode === 'fps'
                ? 'px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white border border-blue-400 shadow'
                : 'px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800/90 text-slate-200 border border-slate-600';
            btnPose.className = mode === 'pose'
                ? 'px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-400 text-slate-950 border border-white shadow'
                : 'px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-500/90 text-slate-950 border border-amber-300';

            if (mode === 'pose') {
                if (document.exitPointerLock) document.exitPointerLock();
                poseBanner.classList.remove('hidden');
                chLayer.classList.add('hidden');
                anaModel.root.visible = true;
                fpsViewModel.root.visible = false;
                player.poseOrbitYaw = -0.62; // Exact 3/4 front-side angle of image_58b867.png!
                player.poseOrbitPitch = 0.04;
                player.poseZoomDist = 1.85;
                showCombatCallout('🏔️ 원작 화보 구도 시점', '드래그로 360° 회전 / 클릭·스킬키(Shift·E·Q·R)로 아나의 전신 모션을 감상하세요!', 'border-amber-400 text-amber-300');
            } else {
                poseBanner.classList.add('hidden');
                chLayer.classList.remove('hidden');
                anaModel.root.visible = (mode === 'tps');
                fpsViewModel.root.visible = (mode === 'fps' && !player.isScoped);
                if (mode === 'fps') {
                    showCombatCallout('🔫 1인칭 전투 시점 활성화', '사격 시 노리쇠 왕복, Shift 수면총 권총, E 수류탄 투척, R 재장전 손 모션이 작동합니다!', 'border-cyan-400 text-cyan-300');
                }
            }
        }

        // Bind UI Buttons
        document.getElementById('btn-cam-tps').addEventListener('click', () => setViewMode('tps'));
        document.getElementById('btn-cam-fps').addEventListener('click', () => setViewMode('fps'));
        document.getElementById('btn-cam-pose').addEventListener('click', () => setViewMode('pose'));
        document.getElementById('btn-exit-pose').addEventListener('click', () => setViewMode('tps'));
        document.getElementById('btn-reset-photo-angle').addEventListener('click', () => {
            player.poseOrbitYaw = -0.62;
            player.poseOrbitPitch = 0.04;
            player.poseZoomDist = 1.85;
        });
        document.getElementById('btn-fill-ult').addEventListener('click', () => {
            player.ultCharge = 100;
            updatePlayerHud();
            showCombatCallout('⚡ 궁극기 100% 충전 완료!', '아군을 조준하고 Q를 눌러 나노 강화제를 투여하세요!', 'border-amber-400 text-amber-300');
        });
        document.getElementById('btn-skill-shift').addEventListener('click', fireSleepDart);
        document.getElementById('btn-skill-e').addEventListener('click', throwBioticGrenade);
        document.getElementById('btn-skill-scope').addEventListener('click', () => toggleScope());
        document.getElementById('btn-ult-q').addEventListener('click', activateNanoBoost);

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>

    <script>
        /* ============================================================================
         * 8. MAIN SIMULATION & RENDER LOOP
         * ============================================================================ */
        const clock = new THREE.Clock();

        function updateSimulation(dt) {
            const elapsed = clock.getElapsedTime();

            // 1. Update Snowflakes
            const sPos = snowParticles.geometry.attributes.position.array;
            for (let i = 0; i < snowCount; i++) {
                sPos[i * 3 + 1] -= dt * 2.2;
                sPos[i * 3] += Math.sin(elapsed + i) * dt * 0.4;
                if (sPos[i * 3 + 1] < 0) sPos[i * 3 + 1] = 25;
            }
            snowParticles.geometry.attributes.position.needsUpdate = true;

            // 2. Player Cooldowns & Action Animation Timers
            if (player.fireCooldown > 0) player.fireCooldown = Math.max(0, player.fireCooldown - dt);
            if (player.recoilOffset > 0) player.recoilOffset = Math.max(0, player.recoilOffset - dt * 1.35);
            if (player.shootAnimTimer > 0) player.shootAnimTimer = Math.max(0, player.shootAnimTimer - dt);
            if (player.sleepAnimTimer > 0) player.sleepAnimTimer = Math.max(0, player.sleepAnimTimer - dt);
            if (player.nadeAnimTimer > 0) player.nadeAnimTimer = Math.max(0, player.nadeAnimTimer - dt);
            if (player.nanoAnimTimer > 0) player.nanoAnimTimer = Math.max(0, player.nanoAnimTimer - dt);
            if (player.cdShift > 0) player.cdShift = Math.max(0, player.cdShift - dt);
            if (player.cdE > 0) player.cdE = Math.max(0, player.cdE - dt);
            if (player.healBoostTimer > 0) player.healBoostTimer = Math.max(0, player.healBoostTimer - dt);

            // Decay 1st-person mouse sway smoothly
            player.swayX = THREE.MathUtils.lerp(player.swayX, 0, dt * 8);
            player.swayY = THREE.MathUtils.lerp(player.swayY, 0, dt * 8);

            if (player.isReloading) {
                player.reloadTimer -= dt;
                if (player.reloadTimer <= 0) {
                    player.isReloading = false;
                    player.ammo = player.maxAmmo;
                }
            }
            // Passive Ultimate trickle
            player.ultCharge = Math.min(100, player.ultCharge + dt * 1.2);
            updatePlayerHud();

            // 3. Player Movement & Multi-Joint Procedural Animation System
            let isMoving = false;
            let moveForwardSign = 0;
            let moveStrafeSign = 0;
            const forward = new THREE.Vector3(-Math.sin(player.yaw), 0, -Math.cos(player.yaw));
            const right = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));
            const moveDir = new THREE.Vector3();

            if (keys['KeyW'] || keys['ArrowUp']) { moveDir.add(forward); moveForwardSign += 1; }
            if (keys['KeyS'] || keys['ArrowDown']) { moveDir.sub(forward); moveForwardSign -= 1; }
            if (keys['KeyD'] || keys['ArrowRight']) { moveDir.add(right); moveStrafeSign += 1; }
            if (keys['KeyA'] || keys['ArrowLeft']) { moveDir.sub(right); moveStrafeSign -= 1; }

            if (moveDir.lengthSq() > 0) {
                moveDir.normalize();
                isMoving = true;
                const speed = player.isScoped ? 3.2 : 6.8;
                player.pos.x = Math.max(-28, Math.min(28, player.pos.x + moveDir.x * speed * dt));
                player.pos.z = Math.max(-28, Math.min(28, player.pos.z + moveDir.z * speed * dt));
            }

            // Smooth walk blend weight & phase
            const targetWalkWeight = isMoving ? 1.0 : 0.0;
            player.walkWeight = THREE.MathUtils.lerp(player.walkWeight, targetWalkWeight, dt * 10);
            if (player.walkWeight > 0.01) {
                const strideRate = player.isScoped ? 6.5 : 11.2;
                player.walkPhase += dt * strideRate * (moveForwardSign < 0 ? -1 : 1);
            }

            // Gravity & Jump
            player.pos.y += player.vel.y * dt;
            if (player.pos.y > 0) {
                player.vel.y -= 18 * dt;
            } else {
                player.pos.y = 0;
                player.vel.y = 0;
            }

            // ====================================================================
            // 3A. ANIMATE 3RD-PERSON ANA MODEL (Walk, Shoot, Bolt, Sleep, Nade, Reload)
            // ====================================================================
            anaModel.root.position.copy(player.pos);
            anaModel.root.rotation.y = player.yaw + Math.PI; // Model faces +Z locally

            // Muzzle flash fade
            const flashAlpha = player.shootAnimTimer > 0.56 ? (player.shootAnimTimer - 0.56) / 0.12 : 0.0;
            anaModel.muzzleFlashMat.opacity = flashAlpha;
            fpsViewModel.fpsMuzzleFlashMat.opacity = flashAlpha;

            // Rifle Bolt Carrier & Biotic Chamber Cycling Animation (0.48s -> 0.15s of shootAnimTimer)
            let boltPull = 0;
            if (player.shootAnimTimer > 0.15 && player.shootAnimTimer < 0.52) {
                const norm = 1.0 - Math.abs(player.shootAnimTimer - 0.335) / 0.185;
                boltPull = Math.max(0, norm);
            }
            anaModel.boltCarrierGroup.position.z = 0.02 - boltPull * 0.095;
            anaModel.bioticChamber.position.z = 0.04 - boltPull * 0.045;

            // Reload Magazine Animation on 3rd-Person Rifle
            if (player.isReloading) {
                const rNorm = 1.0 - (player.reloadTimer / 1.35); // 0 -> 1
                const magDrop = Math.sin(rNorm * Math.PI);
                anaModel.gripCanister.position.y = -0.10 - magDrop * 0.18;
            } else {
                anaModel.gripCanister.position.y = -0.10;
            }

            // Multi-joint Leg & Knee Walk Animation vs Pose Stance
            const w = player.walkWeight;
            const wp = player.walkPhase;
            const lKnee = anaModel.leftLeg.userData.kneeGroup;
            const rKnee = anaModel.rightLeg.userData.kneeGroup;
            const lBoot = anaModel.leftLeg.userData.bootGroup;
            const rBoot = anaModel.rightLeg.userData.bootGroup;

            if (player.viewMode === 'pose' && w < 0.05) {
                // Iconic Sniper Stance from image_58b867.png + live breathing & recoil
                anaModel.pelvis.position.y = 0.84 + Math.sin(elapsed * 1.8) * 0.008;
                anaModel.pelvis.rotation.y = 0;
                anaModel.torso.rotation.y = -0.26;
                anaModel.torso.rotation.x = -player.recoilOffset * 0.35;
                anaModel.headGroup.rotation.y = 0.24;
                anaModel.headGroup.rotation.x = 0.06 - player.recoilOffset * 0.3;

                anaModel.leftLeg.rotation.x = -0.42;
                anaModel.leftLeg.rotation.z = 0.16;
                lKnee.rotation.x = 0.52;
                lBoot.rotation.x = -0.10;

                anaModel.rightLeg.rotation.x = 0.28;
                anaModel.rightLeg.rotation.z = -0.18;
                rKnee.rotation.x = 0.36;
                rBoot.rotation.x = -0.25;
            } else {
                // Dynamic Articulated Walk Cycle (Hip swing + Knee flexion + Ankle roll + Coat sway)
                const lThighSwing = Math.sin(wp) * 0.58 * w;
                const rThighSwing = Math.sin(wp + Math.PI) * 0.58 * w;
                // Knee bends backward (+X in local rig) when leg lifts forward/backward
                const lKneeBend = Math.max(0.08, (Math.cos(wp - 0.5) * 0.5 + 0.5) * 0.88 * w);
                const rKneeBend = Math.max(0.08, (Math.cos(wp + Math.PI - 0.5) * 0.5 + 0.5) * 0.88 * w);

                const strafeLean = moveStrafeSign * 0.12 * w;
                anaModel.pelvis.position.y = 0.90 - w * 0.04 + Math.abs(Math.cos(wp)) * 0.055 * w + (1 - w) * Math.sin(elapsed * 2) * 0.01;
                anaModel.pelvis.rotation.y = Math.sin(wp) * 0.08 * w;

                anaModel.leftLeg.rotation.x = lThighSwing - (1 - w) * 0.18;
                anaModel.leftLeg.rotation.z = 0.08 + strafeLean;
                lKnee.rotation.x = lKneeBend + (1 - w) * 0.25;
                lBoot.rotation.x = -lKneeBend * 0.35;

                anaModel.rightLeg.rotation.x = rThighSwing + (1 - w) * 0.14;
                anaModel.rightLeg.rotation.z = -0.08 + strafeLean;
                rKnee.rotation.x = rKneeBend + (1 - w) * 0.22;
                rBoot.rotation.x = -rKneeBend * 0.35;

                // Coat skirts & Back Cape dynamic flare when walking/jumping
                const airFlare = Math.min(0.45, player.pos.y * 0.25);
                anaModel.leftCoatPanel.rotation.z = 0.28 + Math.abs(lThighSwing) * 0.32 + airFlare;
                anaModel.rightCoatPanel.rotation.z = -0.28 - Math.abs(rThighSwing) * 0.32 - airFlare;
                anaModel.backCapeGroup.rotation.x = 0.12 + w * 0.28 + Math.sin(wp * 2) * 0.08 * w + airFlare;

                anaModel.torso.rotation.y = -0.14 - Math.sin(wp) * 0.07 * w;
                anaModel.torso.rotation.x = w * 0.08 - player.recoilOffset * 0.35;
                anaModel.headGroup.rotation.y = 0.14 + Math.sin(wp) * 0.05 * w;
                anaModel.headGroup.rotation.x = -player.pitch * 0.55 - player.recoilOffset * 0.3;
            }

            // 3rd-Person Rifle & Right Arm Recoil + Walk Bobbing
            const walkBobX = Math.cos(wp) * 0.025 * w;
            const walkBobY = Math.abs(Math.sin(wp)) * 0.032 * w;
            const basePitchAim = (player.viewMode === 'pose' && w < 0.05) ? -0.05 : -player.pitch * 0.85;
            anaModel.rifleGroup.position.x = -0.06 + walkBobX;
            anaModel.rifleGroup.position.y = 0.33 - walkBobY + (player.isReloading ? -0.05 : 0);
            anaModel.rifleGroup.position.z = 0.34 - player.recoilOffset * 0.38;
            anaModel.rifleGroup.rotation.x = basePitchAim - player.recoilOffset * 0.75 + (player.isReloading ? 0.25 : 0);
            anaModel.rifleGroup.rotation.z = player.isReloading ? -0.35 : 0;

            // 3rd-Person Left Arm Skill Animations (Sleep Dart / Biotic Grenade / Nano Boost / Reload / Default Support Grip)
            anaModel.heldGrenadeProp.visible = (player.nadeAnimTimer > 0.25);
            if (player.sleepAnimTimer > 0) {
                // Raise Left Arm forward to aim & fire the Sleep Dart Gauntlet/Pistol!
                const sNorm = player.sleepAnimTimer / 0.78; // 1 -> 0
                const kick = (sNorm > 0.55 && sNorm < 0.85) ? Math.sin((sNorm - 0.55) / 0.3 * Math.PI) * 0.38 : 0;
                anaModel.leftShoulder.rotation.x = -0.65 - kick;
                anaModel.leftShoulder.rotation.y = 0.32;
                anaModel.leftElbow.rotation.x = 0.45 - kick * 0.5;
            } else if (player.nadeAnimTimer > 0) {
                // Wind back left arm and pitch Biotic Grenade forward in an arc!
                const nNorm = 1.0 - (player.nadeAnimTimer / 0.65); // 0 -> 1
                const swing = nNorm < 0.35
                    ? THREE.MathUtils.lerp(0, 0.75, nNorm / 0.35) // Wind back
                    : THREE.MathUtils.lerp(0.75, -1.15, (nNorm - 0.35) / 0.65); // Throw forward!
                anaModel.leftShoulder.rotation.x = swing;
                anaModel.leftShoulder.rotation.y = 0.25;
                anaModel.leftElbow.rotation.x = 0.35;
            } else if (player.nanoAnimTimer > 0) {
                // Raise left wrist to fire Nano Boost electric dart!
                const qNorm = Math.sin((player.nanoAnimTimer / 0.72) * Math.PI);
                anaModel.leftShoulder.rotation.x = -0.85 * qNorm;
                anaModel.leftShoulder.rotation.y = 0.4 * qNorm;
                anaModel.leftElbow.rotation.x = 0.5 * qNorm;
            } else if (player.isReloading) {
                // Left hand reaches under the rifle magazine to swap canisters, then pulls the bolt!
                const rNorm = 1.0 - (player.reloadTimer / 1.35);
                anaModel.leftShoulder.rotation.x = Math.sin(rNorm * Math.PI * 2) * 0.25;
                anaModel.leftShoulder.rotation.y = -0.15;
                anaModel.leftElbow.rotation.x = -0.25 + Math.sin(rNorm * Math.PI) * 0.35;
            } else {
                // Smoothly return left arm to cradle the rifle's white forend
                anaModel.leftShoulder.rotation.x = THREE.MathUtils.lerp(anaModel.leftShoulder.rotation.x, 0, dt * 12);
                anaModel.leftShoulder.rotation.y = THREE.MathUtils.lerp(anaModel.leftShoulder.rotation.y, 0, dt * 12);
                anaModel.leftElbow.rotation.x = THREE.MathUtils.lerp(anaModel.leftElbow.rotation.x, 0, dt * 12);
            }

            // ====================================================================
            // 3B. ANIMATE 1ST-PERSON (FPS) VIEWMODEL (Gun Bob, Recoil, Bolt, Left Hand Skills)
            // ====================================================================
            if (player.viewMode === 'fps' && !player.isScoped) {
                fpsViewModel.root.visible = true;

                // Idle breathing + Walk figure-8 bobbing + Mouse lag sway
                const breathY = Math.sin(elapsed * 2.2) * 0.004;
                const fpsBobX = Math.cos(wp) * 0.018 * w + player.swayX;
                const fpsBobY = Math.abs(Math.sin(wp)) * 0.022 * w + breathY + player.swayY;

                // Recoil kickback & upward muzzle climb
                const kickZ = player.recoilOffset * 0.42;
                const kickPitch = player.recoilOffset * 0.65;

                // Reload tilt & canister swap in 1st-person
                let reloadTiltZ = 0;
                let reloadPitchX = 0;
                if (player.isReloading) {
                    const rNorm = 1.0 - (player.reloadTimer / 1.35); // 0 -> 1
                    const reloadCurve = Math.sin(rNorm * Math.PI);
                    reloadTiltZ = 0.48 * reloadCurve;
                    reloadPitchX = 0.22 * reloadCurve;
                    fpsViewModel.fpsMagazine.position.y = -0.095 - Math.max(0, Math.sin(rNorm * Math.PI * 1.4)) * 0.22;
                    if (rNorm > 0.72) {
                        // Rack the bolt at the end of reload!
                        const rack = Math.sin(((rNorm - 0.72) / 0.28) * Math.PI);
                        boltPull = Math.max(boltPull, rack);
                    }
                } else {
                    fpsViewModel.fpsMagazine.position.y = -0.095;
                }

                fpsViewModel.gunPivot.position.set(
                    0.27 + fpsBobX,
                    -0.25 - fpsBobY - player.recoilOffset * 0.04,
                    -0.46 + kickZ
                );
                fpsViewModel.gunPivot.rotation.set(
                    kickPitch + reloadPitchX,
                    player.swayX * 0.8,
                    -moveStrafeSign * 0.04 * w + reloadTiltZ
                );

                // Animate 1st-Person Side Bolt & Glowing Amber Biotic Vial Plunger
                fpsViewModel.fpsBoltGroup.position.z = -0.01 + boltPull * 0.11;
                fpsViewModel.fpsBioticVial.position.z = -0.02 + boltPull * 0.05;

                // Animate 1st-Person Left Hand & Skill Props (Sleep Dart Pistol / Biotic Grenade / Nano / Reload)
                fpsViewModel.sleepPistolProp.visible = (player.sleepAnimTimer > 0);
                fpsViewModel.nadeHandProp.visible = (player.nadeAnimTimer > 0.22);

                if (player.sleepAnimTimer > 0) {
                    // Left hand pops up on the left side holding the Sleep Dart Pistol and fires with kickback!
                    const sNorm = 1.0 - (player.sleepAnimTimer / 0.78); // 0 -> 1
                    const popIn = Math.sin(Math.min(1, sNorm * 2.5) * Math.PI * 0.5);
                    const recoilKick = (sNorm > 0.14 && sNorm < 0.55)
                        ? Math.sin(((sNorm - 0.14) / 0.41) * Math.PI)
                        : 0;
                    fpsViewModel.leftActionPivot.position.set(
                        -0.19 + fpsBobX * 0.5,
                        -0.32 + popIn * 0.16 + recoilKick * 0.04,
                        -0.42 + recoilKick * 0.11
                    );
                    fpsViewModel.leftActionPivot.rotation.set(
                        recoilKick * 0.48,
                        -0.12,
                        0.08
                    );
                } else if (player.nadeAnimTimer > 0) {
                    // Left hand winds back with the glowing Biotic Grenade and hurls it forward!
                    const nNorm = 1.0 - (player.nadeAnimTimer / 0.65); // 0 -> 1
                    const throwArcZ = nNorm < 0.3
                        ? THREE.MathUtils.lerp(-0.38, -0.22, nNorm / 0.3) // Wind back toward camera
                        : THREE.MathUtils.lerp(-0.22, -0.68, (nNorm - 0.3) / 0.7); // Throw forward!
                    const throwArcY = Math.sin(nNorm * Math.PI) * 0.16;
                    fpsViewModel.leftActionPivot.position.set(
                        -0.16,
                        -0.24 + throwArcY,
                        throwArcZ
                    );
                    fpsViewModel.leftActionPivot.rotation.set(
                        -Math.sin(nNorm * Math.PI) * 0.65,
                        -0.25,
                        0.2
                    );
                } else if (player.nanoAnimTimer > 0) {
                    // Left wrist Nano Launcher thrust forward
                    const qNorm = Math.sin((player.nanoAnimTimer / 0.72) * Math.PI);
                    fpsViewModel.leftActionPivot.position.set(
                        -0.15,
                        -0.16 * qNorm - 0.12,
                        -0.38 - qNorm * 0.16
                    );
                    fpsViewModel.leftActionPivot.rotation.set(0.25 * qNorm, -0.3, 0.35);
                } else if (player.isReloading) {
                    // Left hand moves across to the right to swap the Biotic Rifle canister!
                    const rNorm = 1.0 - (player.reloadTimer / 1.35);
                    const reach = Math.sin(rNorm * Math.PI);
                    fpsViewModel.leftActionPivot.position.set(
                        -0.24 + reach * 0.38,
                        -0.26 - Math.sin(rNorm * Math.PI * 2) * 0.08,
                        -0.44 + reach * 0.08
                    );
                    fpsViewModel.leftActionPivot.rotation.set(0.2 * reach, -0.5 * reach, -0.3 * reach);
                } else {
                    // Rest left hand cleanly under the front receiver of the rifle
                    fpsViewModel.leftActionPivot.position.set(
                        0.12 + fpsBobX,
                        -0.29 - fpsBobY,
                        -0.55 + kickZ
                    );
                    fpsViewModel.leftActionPivot.rotation.set(0.15 + kickPitch, 0.45, -0.25);
                }
            } else {
                fpsViewModel.root.visible = false;
            }

            // 4. Camera Placement based on ViewMode
            if (player.viewMode === 'pose') {
                // Exact Hero Composition from image_58b867.png (with snow-capped parapet ledge & alpine peaks behind her!)
                const focusPoint = player.pos.clone().add(new THREE.Vector3(-0.22, 1.24, -0.28));
                const dist = player.poseZoomDist;
                camera.position.set(
                    focusPoint.x + Math.sin(player.poseOrbitYaw) * Math.cos(player.poseOrbitPitch) * dist,
                    focusPoint.y + Math.sin(player.poseOrbitPitch) * dist,
                    focusPoint.z + Math.cos(player.poseOrbitYaw) * Math.cos(player.poseOrbitPitch) * dist
                );
                camera.lookAt(focusPoint);
            } else if (player.viewMode === 'fps' || player.isScoped) {
                const eyePos = player.pos.clone().add(new THREE.Vector3(0, 1.56, 0));
                camera.position.copy(eyePos);
                const lookTarget = eyePos.clone().add(new THREE.Vector3(
                    -Math.sin(player.yaw) * Math.cos(player.pitch),
                    Math.sin(player.pitch),
                    -Math.cos(player.yaw) * Math.cos(player.pitch)
                ));
                camera.lookAt(lookTarget);
            } else {
                // TPS Over-the-Shoulder (Lets you see Ana AND aim accurately!)
                const rightOffset = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw)).multiplyScalar(0.68);
                const forwardDir = new THREE.Vector3(
                    -Math.sin(player.yaw) * Math.cos(player.pitch),
                    Math.sin(player.pitch),
                    -Math.cos(player.yaw) * Math.cos(player.pitch)
                );
                const pivot = player.pos.clone().add(new THREE.Vector3(0, 1.62, 0)).add(rightOffset);
                camera.position.copy(pivot).sub(forwardDir.clone().multiplyScalar(2.65));
                if (camera.position.y < 0.35) camera.position.y = 0.35;
                camera.lookAt(pivot.clone().add(forwardDir.multiplyScalar(30)));
            }

            // 5. Update Projectiles (Biotic Darts, Sleep Darts, Biotic Grenade)
            for (let i = projectiles.length - 1; i >= 0; i--) {
                const p = projectiles[i];
                p.life -= dt;
                if (p.type === 'biotic-grenade') {
                    p.vel.y -= 16.5 * dt; // Gravity
                    p.mesh.rotation.x += dt * 8;
                }
                p.mesh.position.addScaledVector(p.vel, dt);

                let removed = false;

                // Ground impact for Biotic Grenade
                if (p.type === 'biotic-grenade' && p.mesh.position.y <= 0.18) {
                    detonateBioticGrenade(p.mesh.position.clone());
                    removed = true;
                }

                // Check Bot collisions
                if (!removed) {
                    for (const bot of bots) {
                        const botCenter = bot.group.position.clone().add(new THREE.Vector3(0, 1.15 * bot.baseScale, 0));
                        const hitRadius = p.type === 'biotic-grenade' ? 0.9 : (bot.team === 'ally' ? 1.05 : 0.85);
                        if (p.mesh.position.distanceTo(botCenter) <= hitRadius) {
                            if (p.type === 'biotic-dart') {
                                applyBioticRifleHit(bot, p.mesh.position.clone());
                                removed = true;
                                break;
                            } else if (p.type === 'sleep-dart' && bot.team === 'enemy') {
                                bot.sleepTimer = 5.0; // Put enemy to sleep for 5 seconds!
                                bot.hp = Math.max(5, bot.hp - 5);
                                combatStats.sleep++;
                                combatStats.dmg += 5;
                                updateCombatStatsHud();
                                flashHitMarker(false);
                                spawnParticleBurst(botCenter, 0x22d3ee, 20, 4.5, 0.14);
                                spawnFloatingText(botCenter, '💤 수면 적중! (5.0s)', '#22d3ee', 'text-lg');
                                showCombatCallout(`💤 적 수면 적중! (${bot.name})`, '5초 동안 행동 불가 (공격 시 깨어남)', 'border-cyan-400 text-cyan-300');
                                removed = true;
                                break;
                            } else if (p.type === 'biotic-grenade') {
                                detonateBioticGrenade(p.mesh.position.clone());
                                removed = true;
                                break;
                            }
                        }
                    }
                }

                if (removed || p.life <= 0) {
                    scene.remove(p.mesh);
                    projectiles.splice(i, 1);
                }
            }

            // 6. Update Transient Visual Effects (Particle bursts, Hitscan Beams & Ejected Casings)
            for (let i = transientEffects.length - 1; i >= 0; i--) {
                const fx = transientEffects[i];
                fx.life -= dt;
                const alpha = Math.max(0, fx.life / fx.maxLife);
                fx.mat.opacity = alpha;

                if (fx.type === 'burst') {
                    fx.parts.forEach(pt => {
                        pt.mesh.position.addScaledVector(pt.vel, dt);
                    });
                } else if (fx.type === 'casing') {
                    fx.vel.y -= 14.0 * dt;
                    fx.mesh.position.addScaledVector(fx.vel, dt);
                    fx.mesh.rotation.x += dt * 12;
                    fx.mesh.rotation.z += dt * 9;
                    if (fx.mesh.position.y < 0.04) {
                        fx.mesh.position.y = 0.04;
                        fx.vel.y = Math.abs(fx.vel.y) * 0.35;
                        fx.vel.x *= 0.6;
                        fx.vel.z *= 0.6;
                    }
                }

                if (fx.life <= 0) {
                    scene.remove(fx.group || fx.mesh);
                    transientEffects.splice(i, 1);
                }
            }

            // 7. Update Bots (Patrol, Aerial Flight & Crash-on-Sleep, Combat Skirmish, World-to-Screen UI)
            bots.forEach(bot => {
                // Status timers
                if (bot.sleepTimer > 0) bot.sleepTimer = Math.max(0, bot.sleepTimer - dt);
                if (bot.antiHealTimer > 0) bot.antiHealTimer = Math.max(0, bot.antiHealTimer - dt);
                if (bot.healBoostTimer > 0) bot.healBoostTimer = Math.max(0, bot.healBoostTimer - dt);
                if (bot.nanoTimer > 0) bot.nanoTimer = Math.max(0, bot.nanoTimer - dt);

                // Sleeping Behavior: Bot tips over 90 degrees onto the snow (and Aerial bots fall out of the sky!)
                if (bot.sleepTimer > 0) {
                    bot.bodyPivot.rotation.z = THREE.MathUtils.lerp(bot.bodyPivot.rotation.z, Math.PI / 2.1, dt * 10);
                    bot.bodyPivot.position.y = THREE.MathUtils.lerp(bot.bodyPivot.position.y, 0.25, dt * 10);
                    if (bot.isAerial) {
                        bot.group.position.y = THREE.MathUtils.lerp(bot.group.position.y, 0, dt * 8);
                    }
                } else {
                    bot.bodyPivot.rotation.z = THREE.MathUtils.lerp(bot.bodyPivot.rotation.z, 0, dt * 10);
                    bot.bodyPivot.position.y = THREE.MathUtils.lerp(bot.bodyPivot.position.y, 0, dt * 10);

                    // Patrol Movement (Horizontal + Aerial Hover Wave)
                    const speedMult = bot.nanoTimer > 0 ? 1.65 : 1.0;
                    bot.patrolPhase += dt * bot.patrolSpeed * speedMult;
                    bot.group.position.x = bot.startPos.x + Math.sin(bot.patrolPhase) * bot.patrolRange;
                    if (bot.isAerial) {
                        const targetFlyY = bot.flyHeight + Math.sin(bot.patrolPhase * 1.7) * 1.35;
                        bot.group.position.y = THREE.MathUtils.lerp(bot.group.position.y, targetFlyY, dt * 4);
                    }

                    // Simulated Skirmish Fire (Enemies chip Allies so you always have someone to heal; Nano'd Ally blasts enemies!)
                    bot.fireCooldown -= dt * speedMult;
                    if (bot.fireCooldown <= 0) {
                        bot.fireCooldown = bot.nanoTimer > 0 ? 0.65 : (1.8 + Math.random() * 1.2);
                        if (bot.team === 'enemy') {
                            // Enemy shoots a random ally
                            const allies = bots.filter(b => b.team === 'ally');
                            const target = allies[Math.floor(Math.random() * allies.length)];
                            if (target) {
                                const dmg = target.nanoTimer > 0 ? 11 : 22; // Nano gives 50% damage reduction!
                                target.hp = Math.max(35, target.hp - dmg);
                                spawnBeamTrail(
                                    bot.group.position.clone().add(new THREE.Vector3(0, 1.5, 0)),
                                    target.group.position.clone().add(new THREE.Vector3(0, 1.2, 0)),
                                    0xef4444
                                );
                            }
                        } else if (bot.nanoTimer > 0) {
                            // Nano Boosted Ally counter-attacks enemies!
                            const enemies = bots.filter(b => b.team === 'enemy' && b.sleepTimer <= 0);
                            if (enemies.length > 0) {
                                const target = enemies[Math.floor(Math.random() * enemies.length)];
                                target.hp = Math.max(15, target.hp - 55);
                                spawnBeamTrail(
                                    bot.group.position.clone().add(new THREE.Vector3(0, 1.6, 0)),
                                    target.group.position.clone().add(new THREE.Vector3(0, 1.2, 0)),
                                    0x3b82f6
                                );
                                spawnParticleBurst(target.group.position.clone().add(new THREE.Vector3(0, 1.2, 0)), 0x60a5fa, 10, 4, 0.12);
                            }
                        }
                    }
                }

                // Nano Boost Visual Scale & Electric Aura
                if (bot.nanoTimer > 0) {
                    bot.nanoAuraMat.opacity = 0.45 + Math.sin(elapsed * 16) * 0.2;
                    bot.nanoAura.rotation.y += dt * 4;
                    bot.bodyPivot.scale.setScalar(bot.baseScale * 1.15);
                } else {
                    bot.nanoAuraMat.opacity = 0;
                    bot.bodyPivot.scale.setScalar(bot.baseScale);
                }

                // Project Bot's 3D Head Position to 2D Screen Coordinates for HP Bar & Status Badges
                const headWorldPos = bot.group.position.clone().add(new THREE.Vector3(0, 2.55 * bot.baseScale, 0));
                headWorldPos.project(camera);

                if (headWorldPos.z < 1.0 && player.viewMode !== 'pose') {
                    const sx = (headWorldPos.x * 0.5 + 0.5) * window.innerWidth;
                    const sy = (-headWorldPos.y * 0.5 + 0.5) * window.innerHeight;
                    bot.labelEl.style.left = `${sx}px`;
                    bot.labelEl.style.top = `${sy}px`;
                    bot.labelEl.style.opacity = '1';

                    // Update HP Fill & Frame Border (Yellow for Heal Boost, Purple for Anti-Heal)
                    const pct = Math.max(0, Math.min(100, (bot.hp / bot.maxHp) * 100));
                    bot.hpFillEl.style.width = `${pct}%`;

                    if (bot.antiHealTimer > 0) {
                        bot.hpFrameEl.className = 'hp-frame w-28 h-3.5 bg-slate-950/90 rounded p-0.5 mt-0.5 border-2 border-purple-400 shadow-[0_0_10px_#a855f7] overflow-hidden';
                        bot.hpFillEl.className = 'hp-fill h-full bg-purple-600 transition-all duration-100';
                    } else if (bot.healBoostTimer > 0) {
                        bot.hpFrameEl.className = 'hp-frame w-28 h-3.5 bg-slate-950/90 rounded p-0.5 mt-0.5 border-2 border-amber-300 shadow-[0_0_10px_#fbbf24] overflow-hidden';
                        bot.hpFillEl.className = 'hp-fill h-full bg-amber-300 transition-all duration-100';
                    } else {
                        bot.hpFrameEl.className = 'hp-frame w-28 h-3.5 bg-slate-950/90 rounded p-0.5 mt-0.5 border border-white/30 overflow-hidden';
                        bot.hpFillEl.className = `hp-fill h-full ${bot.team === 'ally' ? 'bg-cyan-400' : 'bg-red-500'} transition-all duration-100`;
                    }

                    // Status Badges (Zzz, Anti-Heal, Heal Boost, Nano Boost)
                    let badgesHtml = '';
                    if (bot.sleepTimer > 0) {
                        badgesHtml += `<span class="px-1.5 py-0.5 rounded bg-cyan-500 text-slate-950 animate-bounce">💤 수면 (${bot.sleepTimer.toFixed(1)}s)</span>`;
                    }
                    if (bot.antiHealTimer > 0) {
                        badgesHtml += `<span class="px-1.5 py-0.5 rounded bg-purple-600 text-white">🚫 치유차단</span>`;
                    }
                    if (bot.healBoostTimer > 0) {
                        badgesHtml += `<span class="px-1.5 py-0.5 rounded bg-amber-400 text-slate-950">➕ 치유강화</span>`;
                    }
                    if (bot.nanoTimer > 0) {
                        badgesHtml += `<span class="px-1.5 py-0.5 rounded bg-blue-500 text-white shadow-[0_0_10px_#3b82f6]">⚡ 나노강화 (${bot.nanoTimer.toFixed(1)}s)</span>`;
                    }
                    bot.badgesEl.innerHTML = badgesHtml;
                } else {
                    bot.labelEl.style.opacity = '0';
                }
            });
        }

        function animateLoop() {
            requestAnimationFrame(animateLoop);
            const dt = Math.min(0.05, clock.getDelta());
            updateSimulation(dt);
            renderer.render(scene, camera);
        }

        window.onload = function () {
            updatePlayerHud();
            showCombatCallout(
                '🎯 아나(Ana) 설산 훈련장에 오신 것을 환영합니다!',
                '좌클릭: 생체 소총 / 우클릭: 조준경 / Shift: 수면총 / E: 생체 수류탄 / Q: 나노 강화제 / C: 원작 포즈 감상',
                'border-blue-400 text-cyan-300'
            );
            animateLoop();
        };
    </script>
</body>
</html>