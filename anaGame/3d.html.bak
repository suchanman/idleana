                new THREE.Vector3(-0.065, 0.07, 0.142),
                new THREE.Vector3(-0.105, 0.00, 0.135),
                new THREE.Vector3(-0.115, -0.06, 0.11)
            ], 0.026, 0.030, matHairWhite));

